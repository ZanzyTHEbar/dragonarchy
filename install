#!/usr/bin/env bash
#
# install — Idempotent dotfiles installer
#
# Usage: ./install --host <hostname> --user <username> [target options]
#
# Applies the complete desired state for this machine:
#   1. System state via Ansible (packages, services, hardware config)
#   2. User state via chezmoi (dotfiles, shell config, applications)
#
# This script is fully idempotent. Running it multiple times is safe.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="${SCRIPT_DIR}"
INVENTORY_FILE="${DOTFILES_INVENTORY:-${REPO_ROOT}/infra/ansible/inventory/hosts.yml}"
CHEZMOI_SYNC_COMMAND="${DOTFILES_CHEZMOI_SYNC:-${REPO_ROOT}/infra/chezmoi/bin/chezmoi-sync}"

# Source logging library if available
if [[ -f "${REPO_ROOT}/scripts/lib/logging.sh" ]]; then
    source "${REPO_ROOT}/scripts/lib/logging.sh"
else
    log_info()  { echo "[INFO]  $*"; }
    log_step()  { echo "[STEP]  $*"; }
    log_warn()  { echo "[WARN]  $*"; }
    log_error() { echo "[ERROR] $*"; }
    log_fatal() { echo "[FATAL] $*"; exit 1; }
    log_success() { echo "[OK]    $*"; }
fi

# yq resolution is read-only here; managed plan generation forbids auto-bootstrap.
# shellcheck disable=SC1091
source "${REPO_ROOT}/scripts/lib/manifest-toml.sh"

# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------

HOST_NAME=""
TARGET_PROFILE=""
TARGET_USER=""
TARGET_HOME=""
TARGET_SOURCE=""
TARGET_CONNECTION=""
SYSTEM_ONLY=false
USER_ONLY=false
DRY_RUN=false
UPDATE=false

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

usage() {
    cat <<EOF
Usage: $0 --host <name> --user <name> [OPTIONS]

Apply the complete desired state for this machine.

Options:
    --update           Upgrade target packages, then converge declared user state
    --host <name>      Target host (required)
    --user <name>      Explicit user from the host's managed_users list
    --target <kind>    Target profile: local-profile, remote-host, or container
    --home <path>      Expected target home; must match inventory
    --source-dir <path>
                        Expected chezmoi source; must be <home>/.local/share/chezmoi
    --connection <mode>
                        Expected connection: local or ssh; must match inventory
    --system-only      Apply only Ansible system state
    --user-only        Apply only chezmoi user state
    --dry-run          Show what would change without applying
    -h, --help         Show this help

Examples:
    $0 --host "$(hostname -s)" --user <name>                 # Full install/update
    $0 --host goldendragon --user daofficialwizard             # Install for specific host
    $0 --host goldendragon --user daofficialwizard --system-only --dry-run
                                                               # Preview system changes
    $0 --host goldendragon --user daofficialwizard --user-only # Update dotfiles only
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --host)
            if [[ $# -lt 2 || -z "${2}" || "${2}" == -* ]]; then
                log_error "--host requires a non-empty value"
                exit 2
            fi
            HOST_NAME="${2:-}"
            shift 2
            ;;
        --user)
            if [[ $# -lt 2 || -z "${2}" || "${2}" == -* ]]; then
                log_error "--user requires a non-empty value"
                exit 2
            fi
            TARGET_USER="${2:-}"
            shift 2
            ;;
        --target|--profile)
            if [[ $# -lt 2 || -z "${2}" || "${2}" == -* ]]; then
                log_error "$1 requires a non-empty value"
                exit 2
            fi
            TARGET_PROFILE="${2:-}"
            shift 2
            ;;
        --home)
            if [[ $# -lt 2 || -z "${2}" || "${2}" == -* ]]; then
                log_error "--home requires a non-empty value"
                exit 2
            fi
            TARGET_HOME="${2:-}"
            shift 2
            ;;
        --source-dir)
            if [[ $# -lt 2 || -z "${2}" || "${2}" == -* ]]; then
                log_error "--source-dir requires a non-empty value"
                exit 2
            fi
            TARGET_SOURCE="${2:-}"
            shift 2
            ;;
        --connection)
            if [[ $# -lt 2 || -z "${2}" || "${2}" == -* ]]; then
                log_error "--connection requires a non-empty value"
                exit 2
            fi
            TARGET_CONNECTION="${2:-}"
            shift 2
            ;;
        --system-only)
            SYSTEM_ONLY=true
            shift
            ;;
        --update)
            UPDATE=true
            shift
            ;;
        --user-only)
            USER_ONLY=true
            shift
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            log_error "Unknown option: $1"
            usage
            exit 2
            ;;
    esac
done

# ---------------------------------------------------------------------------
# Host detection
# ---------------------------------------------------------------------------

[[ -n "${HOST_NAME}" ]] || log_fatal "An explicit --host selection is required."
[[ "${HOST_NAME}" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]] || \
    log_fatal "--host must be a literal safe inventory host name."
if [[ "${SYSTEM_ONLY}" == "true" && "${USER_ONLY}" == "true" ]]; then
    log_fatal "--system-only and --user-only are mutually exclusive."
fi

# ---------------------------------------------------------------------------
# Target tuple resolution
# ---------------------------------------------------------------------------

normalize_connection() {
    case "$1" in
        local)
            printf '%s' local
            ;;
        ssh|remote-ssh)
            printf '%s' ssh
            ;;
        *)
            return 1
            ;;
    esac
}

inventory_tuple() {
    INVENTORY_JSON="${INVENTORY_JSON}" \
        python3 "${REPO_ROOT}/scripts/lib/target-tuple.py" resolve "${TARGET_USER}"
}

configured_source_dir() {
    local config_path line value
    local -a config_paths=()

    if [[ -n "${CHEZMOI_CONFIG_FILE:-}" ]]; then
        config_paths+=("${CHEZMOI_CONFIG_FILE}")
    else
        config_paths+=(
            "${TARGET_HOME}/.config/chezmoi/chezmoi.toml"
            "${TARGET_HOME}/.config/chezmoi/chezmoi.yaml"
            "${TARGET_HOME}/.config/chezmoi/chezmoi.yml"
        )
    fi

    for config_path in "${config_paths[@]}"; do
        [[ -f "${config_path}" ]] || continue
        while IFS= read -r line; do
            if [[ "${line}" =~ ^[[:space:]]*(sourceDir|source-dir|source_dir)[[:space:]]*[:=][[:space:]]*(.+)[[:space:]]*$ ]]; then
                value="${BASH_REMATCH[2]}"
                value="${value#\"}"
                value="${value%\"}"
                value="${value#\'}"
                value="${value%\'}"
                printf '%s' "${value}"
                return 0
            fi
        done <"${config_path}"
    done
}

resolve_target_tuple() {
    local tuple inventory_profile inventory_connection inventory_user inventory_home inventory_source
    [[ -n "${TARGET_USER}" ]] || log_fatal "An explicit --user selection is required."

    INVENTORY_JSON="$(ansible-inventory -i "${INVENTORY_FILE}" --host "${HOST_NAME}" 2>/dev/null)" || \
        log_fatal "Unable to read inventory for host '${HOST_NAME}'."
    tuple="$(inventory_tuple)" || log_fatal "Unable to resolve target tuple for host '${HOST_NAME}' and user '${TARGET_USER}'."
    IFS=$'\t' read -r inventory_profile inventory_connection inventory_user inventory_home inventory_source <<<"${tuple}"

    [[ "${inventory_user}" == "${TARGET_USER}" ]] || log_fatal "Resolved managed user does not match --user."
    [[ "${inventory_user}" != root ]] || log_fatal "Refusing root as a managed user."
    [[ -n "${inventory_home}" && "${inventory_home}" == /* && "${inventory_home}" != / && "${inventory_home}" != /root ]] || \
        log_fatal "Managed user '${TARGET_USER}' has an unsafe or missing home."
    [[ -n "${inventory_source}" && "${inventory_source}" == /* ]] || \
        log_fatal "Managed user '${TARGET_USER}' has an unsafe or missing chezmoi source."

    TARGET_PROFILE="${TARGET_PROFILE:-${inventory_profile}}"
    [[ "${TARGET_PROFILE}" == "${inventory_profile}" ]] || \
        log_fatal "Target profile '${TARGET_PROFILE}' does not match inventory profile '${inventory_profile}'."
    case "${TARGET_PROFILE}" in
        local-profile|remote-host|container)
            ;;
        *)
            log_fatal "Unsupported target profile: ${TARGET_PROFILE}"
            ;;
    esac

    inventory_connection="$(normalize_connection "${inventory_connection}")" || \
        log_fatal "Inventory has an unsupported target connection."
    if [[ -n "${TARGET_CONNECTION}" ]]; then
        TARGET_CONNECTION="$(normalize_connection "${TARGET_CONNECTION}")" || \
            log_fatal "Unsupported target connection: ${TARGET_CONNECTION}"
        [[ "${TARGET_CONNECTION}" == "${inventory_connection}" ]] || \
            log_fatal "Target connection '${TARGET_CONNECTION}' does not match inventory connection '${inventory_connection}'."
    else
        TARGET_CONNECTION="${inventory_connection}"
    fi

    case "${TARGET_PROFILE}:${TARGET_CONNECTION}" in
        local-profile:local|remote-host:ssh|container:local)
            ;;
        *)
            log_fatal "Target profile '${TARGET_PROFILE}' and connection '${TARGET_CONNECTION}' are inconsistent."
            ;;
    esac
    if [[ "${HOST_NAME}" == opencode-runtime && ( "${TARGET_PROFILE}" != container || "${TARGET_CONNECTION}" != local ) ]]; then
        log_fatal "opencode-runtime is a forced local container target."
    fi
    if [[ "${HOST_NAME}" != opencode-runtime && "${TARGET_PROFILE}" == container ]]; then
        log_fatal "Only opencode-runtime may use the container target profile."
    fi

    if [[ -n "${TARGET_HOME}" && "${TARGET_HOME}" != "${inventory_home}" ]]; then
        log_fatal "Target home '${TARGET_HOME}' does not match inventory home '${inventory_home}'."
    fi
    TARGET_HOME="${inventory_home}"
    if [[ -n "${TARGET_SOURCE}" && "${TARGET_SOURCE}" != "${inventory_source}" ]]; then
        log_fatal "Target source '${TARGET_SOURCE}' does not match inventory source '${inventory_source}'."
    fi
    TARGET_SOURCE="${inventory_source}"
    [[ "${TARGET_SOURCE}" == "${TARGET_HOME}/.local/share/chezmoi" ]] || \
        log_fatal "Configured chezmoi source must be under the selected target home."

    if [[ "${TARGET_CONNECTION}" == local && "${HOME:-}" != "${TARGET_HOME}" ]]; then
        log_fatal "Local target home '${TARGET_HOME}' does not match controller HOME '${HOME:-}'."
    fi

    if [[ "${TARGET_CONNECTION}" == local ]]; then
        local configured_source
        configured_source="$(configured_source_dir || true)"
        if [[ -n "${configured_source}" && "${configured_source}" != "${TARGET_SOURCE}" ]]; then
            log_fatal "Configured chezmoi source '${configured_source}' is an alternate source."
        fi
        if [[ -n "${CHEZMOI_SOURCE_DIR:-}" && "${CHEZMOI_SOURCE_DIR}" != "${TARGET_SOURCE}" ]]; then
            log_fatal "CHEZMOI_SOURCE_DIR points to an alternate source."
        fi
    fi

    log_info "Resolved target: host=${HOST_NAME} user=${TARGET_USER} home=${TARGET_HOME} source=${TARGET_SOURCE} connection=${TARGET_CONNECTION} profile=${TARGET_PROFILE}"
}

# ---------------------------------------------------------------------------
# Prerequisite checks
# ---------------------------------------------------------------------------

log_step "Checking prerequisites"

check_cmd() {
    local cmd="$1"
    local purpose="$2"
    if ! command -v "${cmd}" >/dev/null 2>&1; then
        log_fatal "${cmd} is required (${purpose}) but not found."
    fi
}

check_cmd ansible-inventory "Ansible inventory validation"
check_cmd python3 "inventory tuple validation"
if [[ "${USER_ONLY}" != "true" ]]; then
    check_cmd ansible-playbook "Ansible system provisioning"
fi
if [[ "${USER_ONLY}" != "true" && "${UPDATE}" != "true" ]]; then
    if ! manifest_yq_resolve_bin >/dev/null 2>&1; then
        log_fatal "mikefarah yq v4 is required for package plan resolution; install it explicitly (managed plan generation does not auto-bootstrap)."
    fi
fi

resolve_target_tuple

if [[ "${UPDATE}" == true && "${TARGET_PROFILE}" == container ]]; then
    if ! systemd-detect-virt --container --quiet; then
        log_fatal "The container profile requires execution inside a detected container."
    fi
fi

# A plan only: do not run check-mode package tasks or promote chezmoi sources.
if [[ "${UPDATE}" == true && "${DRY_RUN}" == true ]]; then
    log_info "Update plan for ${HOST_NAME} (${TARGET_PROFILE}, ${TARGET_CONNECTION})"
    [[ "${USER_ONLY}" == true ]] || log_info "System: update.yml targeted package upgrades"
    [[ "${SYSTEM_ONLY}" == true ]] || log_info "User: declared chezmoi convergence for ${TARGET_USER} at ${TARGET_HOME} from ${TARGET_SOURCE}"
    exit 0
fi

if [[ "${SYSTEM_ONLY}" != "true" ]]; then
    [[ -x "${CHEZMOI_SYNC_COMMAND}" ]] || \
        log_fatal "chezmoi-sync is required (${CHEZMOI_SYNC_COMMAND}) but not executable."
    if [[ "${TARGET_CONNECTION}" == local ]]; then
        check_cmd chezmoi "Chezmoi dotfile management"
    else
        check_cmd ansible-playbook "Remote chezmoi execution"
    fi
fi

# ---------------------------------------------------------------------------
# Ansible: System state
# ---------------------------------------------------------------------------

apply_system_state() {
    log_step "Applying system state via Ansible"

    local wrapper="${REPO_ROOT}/infra/ansible/run-playbook.sh"
    local playbook_dir="${REPO_ROOT}/infra/ansible/playbooks"
    local inventory="${INVENTORY_FILE}"

    if [[ ! -x "${wrapper}" ]]; then
        log_fatal "Ansible wrapper not found or not executable: ${wrapper}"
    fi

    local ansible_args=()
    if [[ "${DRY_RUN}" == "true" ]]; then
        ansible_args+=(--check --diff)
    fi

    if [[ "${UPDATE}" == true ]]; then
        log_info "Running update playbook for ${HOST_NAME}..."
        "${wrapper}" "${playbook_dir}/update.yml" \
            --limit "${HOST_NAME}" \
            --connection "${TARGET_CONNECTION}" \
            --extra-vars "dotfiles_target_profile=${TARGET_PROFILE} dotfiles_target_user=${TARGET_USER} dotfiles_target_home=${TARGET_HOME} dotfiles_target_source=${TARGET_SOURCE} dotfiles_target_connection=${TARGET_CONNECTION}"
        return 0
    fi

    # Site already imports foundation through the tranche graph.
    log_info "Running site playbook for ${HOST_NAME}..."
    "${wrapper}" "${playbook_dir}/site.yml" \
        --limit "${HOST_NAME}" \
        --connection "${TARGET_CONNECTION}" \
        --extra-vars "dotfiles_target_profile=${TARGET_PROFILE} dotfiles_target_user=${TARGET_USER} dotfiles_target_home=${TARGET_HOME} dotfiles_target_source=${TARGET_SOURCE} dotfiles_target_connection=${TARGET_CONNECTION}" \
        "${ansible_args[@]}"

    log_success "System state applied"
}

# ---------------------------------------------------------------------------
# Chezmoi: User state
# ---------------------------------------------------------------------------

apply_user_state() {
    log_step "Applying user state via chezmoi"

    local chezmoi_source="${TARGET_SOURCE}"

    if [[ "${TARGET_CONNECTION}" != local ]]; then
        if [[ "${DRY_RUN}" == "true" ]]; then
            log_info "Remote dry-run is isolated; no remote source or home will be changed."
            return 0
        fi

        ANSIBLE_CONFIG="${REPO_ROOT}/infra/ansible/ansible.cfg" \
            INVENTORY_JSON="${INVENTORY_JSON}" \
            python3 -B "${REPO_ROOT}/scripts/lib/remote-sync.py" \
                --inventory "${INVENTORY_FILE}" --host "${HOST_NAME}" \
                --user "${TARGET_USER}" --home "${TARGET_HOME}" --source "${chezmoi_source}"
        log_success "Remote user state applied"
        return 0
    fi

    if [[ "${DRY_RUN}" == "true" ]]; then
        (
            local dry_run_root dry_run_source
            dry_run_root="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-chezmoi-dry-run.XXXXXX")"
            trap 'rm -rf "${dry_run_root}"' EXIT
            dry_run_source="${dry_run_root}/source"
            mkdir -- "${dry_run_source}"

            # Dry-run sync must not mutate the user's real chezmoi source tree.
            if [[ -d "${chezmoi_source}" ]]; then
                log_info "Copying existing chezmoi source to temporary dry-run source..."
                cp -a "${chezmoi_source}/." "${dry_run_source}/"
            else
                log_info "No existing chezmoi source found; using empty temporary dry-run source..."
            fi

            log_info "Syncing dotfiles from repo to temporary chezmoi source..."
            INVENTORY_JSON="${INVENTORY_JSON}" "${CHEZMOI_SYNC_COMMAND}" \
                --host "${HOST_NAME}" \
                --source-dir "${dry_run_source}"

            log_info "Previewing chezmoi changes..."
            chezmoi --source "${dry_run_source}" --destination "${TARGET_HOME}" diff
        )
        log_success "User state previewed"
    else
        # Sync manifest-declared dotfiles into chezmoi source
        log_info "Syncing dotfiles from repo to chezmoi source..."
        INVENTORY_JSON="${INVENTORY_JSON}" "${CHEZMOI_SYNC_COMMAND}" \
            --host "${HOST_NAME}" \
            --source-dir "${chezmoi_source}"

        log_info "Applying chezmoi state..."
        chezmoi --source "${chezmoi_source}" --destination "${TARGET_HOME}" apply
        local desktop_stack
        desktop_stack="$(INVENTORY_JSON="${INVENTORY_JSON}" python3 -c 'import json, os; print(json.loads(os.environ["INVENTORY_JSON"])["host_desktop_stack"])')"
        if [[ "${desktop_stack}" == hyprland ]]; then
            HOME="${TARGET_HOME}" XDG_CONFIG_HOME="${TARGET_HOME}/.config" \
                "${TARGET_HOME}/.local/bin/theme-bootstrap"
        fi
        log_success "User state applied"
    fi
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

log_step "=== Installing dotfiles for host '${HOST_NAME}' ==="

if [[ "${USER_ONLY}" != "true" ]]; then
    apply_system_state
fi

if [[ "${SYSTEM_ONLY}" != "true" ]]; then
    apply_user_state
fi

if [[ "${USER_ONLY}" == "true" ]]; then
    log_success "=== User state complete for host '${HOST_NAME}' ==="
elif [[ "${UPDATE}" == "true" ]]; then
    log_success "=== Update complete for host '${HOST_NAME}' ==="
elif [[ "${SYSTEM_ONLY}" == "true" ]]; then
    log_success "=== System state complete for host '${HOST_NAME}' ==="
else
    log_success "=== Install complete for host '${HOST_NAME}' ==="
fi
