#!/usr/bin/env bash
set -euo pipefail

# Clipse and Elephant have independent histories. Never delete guessed files or
# restart a backend while claiming that clears persisted clipboard data.
choice=$(printf '%s\n' 'Clipse (quick TUI)' 'Walker (images, edit and history actions)' \
    'Clear Clipse history (including pinned)' 'Settings' | walker --dmenu -p 'Clipboard Manager')
case "$choice" in
    'Clipse (quick TUI)') exec kitty --class clipse-enhanced -e "$HOME/.local/bin/clipse-wrapper" ;;
    'Walker (images, edit and history actions)') exec walker -m clipboard ;;
    'Clear Clipse history (including pinned)') exec clipse -clear-all ;;
    'Settings') exec kitty -e nvim "${XDG_CONFIG_HOME:-$HOME/.config}/clipse/config.json" \
        "${XDG_CONFIG_HOME:-$HOME/.config}/elephant/clipboard.toml" ;;
esac
