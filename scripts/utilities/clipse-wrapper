#!/usr/bin/env bash
set -euo pipefail

case "${1:-normal}" in
    normal) ;;
    search) printf '%s\n' 'Clipse 1.2.1: press / to filter; Tab toggles pinned entries.' >&2 ;;
    *) printf '%s\n' 'usage: clipse-wrapper [normal|search] (search uses the TUI / filter)' >&2; exit 2 ;;
esac
(( $# <= 1 )) || { printf '%s\n' 'No positional query API in Clipse 1.2.1; use / in the TUI.' >&2; exit 2; }
"$HOME/.local/bin/dragon-clipboard-session" --start
# The caller's Kitty retains native selection, preview, image and pin behavior.
# No clipboard-output/pause probe, preference writer or detached listener here.
exec /usr/local/bin/clipse -enable-real-time
