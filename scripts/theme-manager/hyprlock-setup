#!/usr/bin/env bash
# Ensure a minimal Hyprlock config exists, using the current palette at creation.

set -euo pipefail

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
[[ "$CONF_DIR" = /* ]] || CONF_DIR="$PWD/$CONF_DIR"
CONF_FILE="$CONF_DIR/hyprlock.conf"
LEGACY_CONF1="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/config/hyprlock.conf"
ALT_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/hyprlock.conf"
PALETTE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/current/theme/hyprland-palette.conf"
BG_LINK="${XDG_CONFIG_HOME:-$HOME/.config}/current/background"

# Keep source paths anchored if the configured home is relative and we change
# directory below. The background path remains as configured in the output.
for name in LEGACY_CONF1 ALT_CONF PALETTE_FILE; do
  if [[ "${!name}" != /* ]]; then
    printf -v "$name" '%s/%s' "$PWD" "${!name}"
  fi
done

mkdir -p "$CONF_DIR"
cd -- "$CONF_DIR"

# The path can be renamed or redirected after cd. This is a point-in-time
# check, not a lock against subsequent ancestor changes.
directory_unchanged() {
  if [[ "$CONF_DIR" -ef . ]]; then
    return 0
  fi
  echo "hyprlock-setup: config directory changed: $CONF_DIR" >&2
  return 1
}

# A regular file or any symlink, including a dangling one, is already owned by
# the user. Do not open a special file or treat it as a usable configuration.
existing_config() {
  if [[ -L ./hyprlock.conf || -f ./hyprlock.conf ]]; then
    return 0
  fi
  if [[ -e ./hyprlock.conf ]]; then
    echo "hyprlock-setup: conflicting path left untouched: $CONF_FILE" >&2
    return 2
  fi
  return 1
}

finish_if_existing() {
  local status
  directory_unchanged || exit 1
  if existing_config; then
    directory_unchanged || exit 1
    exit 0
  else
    status=$?
    [[ $status -eq 1 ]] || exit 1
  fi
}

finish_if_existing

# If user keeps config in legacy or alt locations, symlink to canonical and stop
for source in "$LEGACY_CONF1" "$ALT_CONF"; do
  if [[ -f "$source" ]]; then
    directory_unchanged || exit 1
    if ln -sT -- "$source" ./hyprlock.conf 2>/dev/null; then
      directory_unchanged || exit 1
      echo "Hyprlock config linked: $CONF_FILE -> $source"
      exit 0
    fi
    finish_if_existing
    echo "hyprlock-setup: unable to link $CONF_FILE" >&2
    exit 1
  fi
done

# Fallback colors
FG="rgba(0xe6edf3ff)"
ACC="rgba(0x79c0ffff)"
PANEL_BG="rgba(0x141a24cc)"
OUTLINE="rgba(0xffffff40)"

# Attempt to read palette variables if present
if [[ -f "$PALETTE_FILE" ]]; then
  get_rgba() {
    grep -m 1 -E "^\\\$${1}[[:space:]]*=[[:space:]]*rgba\([^)]*\)" "$PALETTE_FILE" |
      sed -E 's/#.*//; s/^[^=]*=[[:space:]]*rgba\(([^)]*)\).*/rgba(\1)/' | tr -d ' \n'
  }
  FG_CAND=$(get_rgba foreground || true)
  ACC_CAND=$(get_rgba accent || true)
  [[ -n "${FG_CAND:-}" ]] && FG="$FG_CAND"
  [[ -n "${ACC_CAND:-}" ]] && ACC="$ACC_CAND"
fi

# Create the file privately, then link it into place without replacing an
# existing leaf. A same-directory hard link also keeps publication atomic.
directory_unchanged || exit 1
STAGE_DIR=$(mktemp -d .hyprlock-setup.XXXXXXXX)
trap 'rm -f -- "$STAGE_DIR/config"; rmdir -- "$STAGE_DIR" 2>/dev/null || true' EXIT
( set -o noclobber; cat >"$STAGE_DIR/config" <<EOF
# Generated by hyprlock-setup

general {
  grace = 0
}

background {
  monitor = 
  path = ${BG_LINK}
  blur_passes = 2
  blur_size = 8
  brightness = 0.85
}

label {
  monitor = 
  text = \$TIME
  font_family = Inter
  font_size = 48
  color = ${FG}
  position = 0, 120
  halign = center
  valign = top
}

input-field {
  monitor = 
  size = 420, 52
  position = 0, 0
  halign = center
  valign = center
  rounding = 12

  # Colors
  outer_color = ${OUTLINE}
  inner_color = ${PANEL_BG}
  font_color = ${FG}
  check_color = ${ACC}
  fail_color = rgba(0xff5555ff)

  # Behavior
  dots_center = true
  fade_on_empty = false
  placeholder_text = <i>Enter password…</i>
}
EOF
)

directory_unchanged || exit 1
if ln -PT -- "$STAGE_DIR/config" ./hyprlock.conf 2>/dev/null; then
  directory_unchanged || exit 1
  echo "Hyprlock config created at $CONF_FILE"
else
  finish_if_existing
  echo "hyprlock-setup: unable to create $CONF_FILE" >&2
  exit 1
fi
