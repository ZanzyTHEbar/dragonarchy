#!/usr/bin/env bash
set -euo pipefail

# Pure canonical Clipse 1.2.1 renderer. Callers supply selected-theme staging;
# publication belongs to theme-bootstrap/theme-set, never this renderer.
: "${THEMES_DIR:?Supply a selected-theme staging directory}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/theme-utils.sh
source "$SCRIPT_DIR/lib/theme-utils.sh"
export LC_ALL=C

for theme in "$THEMES_DIR"/*/; do
    palette="${theme}hyprland-palette.conf"
    [[ -f "$palette" ]] || { echo "Missing palette: $palette" >&2; exit 1; }
    tm_validate_palette "$palette"
    background="$(tm_palette_hex "$palette" background)"
    foreground="$(tm_palette_hex "$palette" foreground)"
    accent="$(tm_palette_hex "$palette" accent)"
    comment="$(tm_palette_hex "$palette" comment)"
    green="$(tm_palette_hex "$palette" green)"
    yellow="$(tm_palette_hex "$palette" yellow "$accent")"
    cat > "${theme}clipse.json" <<EOF
{
  "useCustom": true,
  "TitleFore": "$background",
  "TitleBack": "$accent",
  "TitleInfo": "$accent",
  "NormalTitle": "$foreground",
  "DimmedTitle": "$comment",
  "SelectedTitle": "$accent",
  "NormalDesc": "$comment",
  "DimmedDesc": "$comment",
  "SelectedDesc": "$foreground",
  "StatusMsg": "$green",
  "PinIndicatorColor": "$yellow",
  "SelectedBorder": "$accent",
  "SelectedDescBorder": "$accent",
  "FilteredMatch": "$green",
  "FilterPrompt": "$accent",
  "FilterInfo": "$comment",
  "FilterText": "$foreground",
  "FilterCursor": "$yellow",
  "HelpKey": "$foreground",
  "HelpDesc": "$comment",
  "PageActiveDot": "$accent",
  "PageInactiveDot": "$comment",
  "DividerDot": "$comment",
  "PreviewedText": "$foreground",
  "PreviewBorder": "$accent"
}
EOF
done
