#!/usr/bin/env bash
#
# dynamic-monitors
#
# Apply a stable Hyprland monitor layout across changing docks/outputs.
# Policy:
# - the internal panel (eDP/LVDS/DSI) is always the primary display at x=0
# - external monitors are appended to the right, left-to-right
# - every monitor uses its preferred/native mode
# - internal high-DPI panels prefer fractional scale over lower non-native modes
# - scale is derived from panel DPI when physical dimensions are available
#
set -euo pipefail
IFS=$'\n\t'

log_info() { echo "[INFO] $1"; }
log_success() { echo "[SUCCESS] $1"; }
log_warning() { echo "[WARNING] $1" >&2; }
log_error() { echo "[ERROR] $1" >&2; }
log_step() { echo "[STEP] $1"; }

POLL_SECONDS="${MONITOR_LAYOUT_POLL_SECONDS:-5}"
RUNTIME_MONITOR_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/monitor-runtime.lua"
POWER_POLICY="${MONITOR_BATTERY_POLICY:-0}"
REFRESH_OVERRIDE="${XDG_CONFIG_HOME:-$HOME/.config}/dynamic-monitors/internal-refresh-rate"

power_source() {
  local supply type online battery=0 external=0
  for supply in /sys/class/power_supply/*; do
    [[ -r "$supply/type" ]] || continue
    read -r type < "$supply/type"
    [[ "$type" != Battery ]] || battery=1
    case "$type" in Mains|USB|USB_C|USB_PD|USB_PD_DRP) ;; *) continue ;; esac
    [[ -r "$supply/online" ]] || continue
    external=1
    read -r online < "$supply/online"
    if [[ "$online" == 1 ]]; then echo ac; return; fi
  done
  if (( battery && external )); then echo bat
  elif (( ! battery )); then echo ac
  else log_error 'Cannot identify external power state'; return 1
  fi
}

internal_refresh() {
  local rate=auto source
  [[ ! -r "$REFRESH_OVERRIDE" ]] || read -r rate < "$REFRESH_OVERRIDE" || true
  if [[ "$rate" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    printf '%s\n' "$rate"
  elif [[ "$POWER_POLICY" == 1 ]]; then
    source="$(power_source)" || return 1
    if [[ "$source" == bat ]]; then echo 60; else echo 0; fi
  else echo 0
  fi
}

power_brightness_transition() {
  [[ "$POWER_POLICY" == 1 ]] || return 0
  local source="$1" device current maximum target saved applied state temporary
  local devices=()
  state="${XDG_RUNTIME_DIR:?}/dynamic-monitors-power"
  [[ ! -L "$state" ]] || { log_error 'Refusing symlink brightness state'; return 1; }
  mkdir -p -m 700 "$state"
  [[ "$(stat -c '%u:%a' "$state")" == "$(id -u):700" ]] || return 1
  # Discover the sole panel backlight instead of hard-coding amdgpu_bl1.
  for device in /sys/class/backlight/*; do [[ ! -e "$device" ]] || devices+=("${device##*/}"); done
  (( ${#devices[@]} <= 1 )) || { log_error 'Ambiguous panel backlight'; return 1; }
  [[ ! -e /sys/class/leds/asus::kbd_backlight ]] || devices+=('asus::kbd_backlight')
  for device in "${devices[@]}"; do
    current="$(brightnessctl -d "$device" get)" || return 1
    maximum="$(brightnessctl -d "$device" max)" || return 1
    [[ "$current" =~ ^[0-9]+$ && "$maximum" =~ ^[0-9]+$ ]] || return 1
    [[ ! -L "$state/$device" ]] || return 1
    if [[ "$source" == bat ]]; then
      [[ ! -f "$state/$device" ]] || continue
      if [[ "$device" == asus::kbd_backlight ]]; then target=0; else target=$((maximum * 40 / 100)); fi
      (( current > target )) || target="$current"
      brightnessctl -q -d "$device" set "$target" || return 1
      applied="$(brightnessctl -d "$device" get)" || return 1
      temporary="$(mktemp "$state/.snapshot.XXXXXX")"
      printf '%s %s\n' "$current" "$applied" > "$temporary"
      mv "$temporary" "$state/$device"
    elif [[ -f "$state/$device" ]]; then
      IFS=' ' read -r saved applied < "$state/$device"
      [[ "$saved" =~ ^[0-9]+$ && "$applied" =~ ^[0-9]+$ ]] || return 1
      if [[ "$applied" == "$current" ]]; then
        brightnessctl -q -d "$device" set "$saved" || return 1
      fi
      rm -- "$state/$device"
    fi
  done
}

usage() {
  cat <<'EOF'
dynamic-monitors - Hyprland monitor layout helper

Commands:
  --dry-run   Print the monitor commands that would be applied
  --apply     Apply the current layout once
  --watch     Watch for monitor topology changes and re-apply
  --status    Validate dependencies and print the current topology signature
  --suspend-if-battery  Idle action; suspend only on a discovered battery source

Environment:
  MONITOR_LAYOUT_POLL_SECONDS   Poll interval for --watch (default: 5)
  MONITOR_BATTERY_POLICY        1: native60Hz / brightness cap40 / keyboard off
  ~/.config/dynamic-monitors/internal-refresh-rate: auto or available native Hz
EOF
}

have_cmd() {
  command -v "$1" >/dev/null 2>&1
}

require_deps() {
  local ok=0
  if ! have_cmd hyprctl; then
    log_error "hyprctl is required"
    ok=1
  fi
  if ! have_cmd jq; then
    log_error "jq is required"
    ok=1
  fi
  return "$ok"
}

is_internal_name() {
  [[ "$1" =~ ^(eDP|LVDS|DSI) ]]
}

scale_for_monitor() {
  local name="$1"
  local width="$2"
  local physical_width_mm="$3"
  local dpi=""

  if [[ "$physical_width_mm" =~ ^[0-9]+$ ]] && (( physical_width_mm > 0 )); then
    dpi="$(awk -v px="$width" -v mm="$physical_width_mm" 'BEGIN { printf "%.2f", px / (mm / 25.4) }')"
    if is_internal_name "$name"; then
      if awk -v dpi="$dpi" 'BEGIN { exit !(dpi >= 240) }'; then
        echo "2"
        return 0
      fi
      if awk -v dpi="$dpi" 'BEGIN { exit !(dpi >= 170) }'; then
        echo "1.5"
        return 0
      fi
      if awk -v dpi="$dpi" 'BEGIN { exit !(dpi >= 135) }'; then
        echo "1.25"
        return 0
      fi
    else
      if awk -v dpi="$dpi" 'BEGIN { exit !(dpi >= 170) }'; then
        echo "2"
        return 0
      fi
      if awk -v dpi="$dpi" 'BEGIN { exit !(dpi >= 140) }'; then
        echo "1.5"
        return 0
      fi
    fi
  fi

  if is_internal_name "$name"; then
    if (( width >= 3200 )); then
      echo "2"
    elif (( width >= 2560 )); then
      echo "1.5"
    elif (( width >= 1920 )); then
      echo "1.25"
    else
      echo "1"
    fi
    return 0
  fi

  echo "1"
}

native_dimensions_for_modes() {
  local fallback_width="$1"
  local fallback_height="$2"
  local available_modes_b64="${3:-}"
  local modes_json="[]"

  if [[ -n "$available_modes_b64" ]]; then
    modes_json="$(printf '%s' "$available_modes_b64" | base64 -d 2>/dev/null || echo '[]')"
  fi

  printf '%s' "$modes_json" | jq -r \
    --argjson fallback_width "$fallback_width" \
    --argjson fallback_height "$fallback_height" '
    map(
      (capture("^(?<w>[0-9]+)x(?<h>[0-9]+)@(?<hz>[0-9.]+)Hz$")?)
      | select(.)
      | {
          width: (.w | tonumber),
          height: (.h | tonumber)
        }
    )
    | sort_by(.width * .height)
    | last as $best
    | if $best then
        "\($best.width)\t\($best.height)"
      else
        "\($fallback_width)\t\($fallback_height)"
      end
  '
}

choose_mode_for_monitor() {
  local _name="${1:-}"
  local native_width="${2:-}"
  local native_height="${3:-}"
  local _physical_width_mm="${4:-}"
  local available_modes_b64="${5:-}"
  local modes_json='[]' refresh=0
  if is_internal_name "$_name"; then refresh="$(internal_refresh)"; fi

  if [[ -n "$available_modes_b64" ]]; then
    modes_json="$(printf '%s' "$available_modes_b64" | base64 -d 2>/dev/null || echo '[]')"
  fi

  printf '%s' "$modes_json" | jq -r \
    --argjson native_width "$native_width" \
    --argjson native_height "$native_height" --argjson refresh "$refresh" '
    map((capture("^(?<width>[0-9]+)x(?<height>[0-9]+)@(?<refresh>[0-9.]+)Hz$")?) | select(.))
    | map({width: (.width | tonumber), height: (.height | tonumber), refresh: (.refresh | tonumber)})
    | map(select(.width == $native_width and .height == $native_height))
    | sort_by(.refresh)
    | (if $refresh > 0 then (map(select((.refresh - $refresh) | fabs < 0.5)) | first) // last else last end) // null
    | if . then "\(.width)x\(.height)@\(.refresh)Hz" else "preferred" end
  '
}

scale_for_selected_mode() {
  local name="$1"
  local native_width="$2"
  local physical_width_mm="$3"
  local mode="$4"

  scale_for_monitor "$name" "$native_width" "$physical_width_mm"
}

width_for_mode() {
  local fallback_width="$1"
  local mode="$2"

  if [[ "$mode" =~ ^([0-9]+)x([0-9]+)@ ]]; then
    echo "${BASH_REMATCH[1]}"
    return 0
  fi

  echo "$fallback_width"
}

logical_width_for_mode() {
  local width="$1"
  local scale="${2:-1}"

  awk -v width="$width" -v scale="$scale" 'BEGIN {
    scale_num = scale + 0
    if (scale_num <= 0) {
      scale_num = 1
    }

    logical_width = width / scale_num
    printf "%d\n", int(logical_width + 0.5)
  }'
}

write_runtime_monitor_conf() {
  local rules=("$@")
  local tmpfile

  mkdir -p "$(dirname "$RUNTIME_MONITOR_CONF")"
  [[ ! -L "$RUNTIME_MONITOR_CONF" ]] || { log_error 'Runtime monitor file is a symlink; cutover required'; return 1; }
  if [[ -e "$RUNTIME_MONITOR_CONF" ]] && ! grep -qxF -- '-- Generated by Dragon dynamic-monitors; runtime-owned.' "$RUNTIME_MONITOR_CONF"; then
    log_error 'Unknown runtime monitor file; preserve and reconcile before cutover'
    return 1
  fi
  tmpfile="$(mktemp "${RUNTIME_MONITOR_CONF}.XXXXXX")"
  {
    printf '%s\n' '-- Generated by Dragon dynamic-monitors; runtime-owned.'
    printf '%s\n' "${rules[@]}"
  } >"$tmpfile"
  if [[ -f "$RUNTIME_MONITOR_CONF" ]] && cmp -s "$tmpfile" "$RUNTIME_MONITOR_CONF"; then
    rm -- "$tmpfile"
  else mv "$tmpfile" "$RUNTIME_MONITOR_CONF"
  fi
}

monitors_json() {
  hyprctl monitors -j
}

topology_signature() {
  monitors_json | jq -r '
    sort_by(.name)
    | map([
        .name,
        (.description // ""),
        (.width | tostring),
        (.height | tostring),
        (.physicalWidth | tostring),
        (.physicalHeight | tostring)
      ] | join(":"))
    | join("|")
  '
}

current_layout_signature() {
  monitors_json | jq -r '
    sort_by(.name)
    | map([
        .name,
        (.x | tostring),
        (.y | tostring),
        ((.scale // 1) | tostring | sub("\\.?0+$"; "")),
        (.width | tostring), (.height | tostring),
        ((.refreshRate * 10 | round) | tostring)
      ] | join(":"))
    | join("|")
  '
}

layout_rows() {
  monitors_json | jq -r '
    sort_by((if (.name | test("^(eDP|LVDS|DSI)")) then 0 else 1 end), .x, .name)
    | .[]
    | [
        .name,
        (.width | tostring),
        (.height | tostring),
        (.physicalWidth | tostring),
        (.physicalHeight | tostring),
        ((.availableModes // []) | tojson | @base64),
        (if (.name | test("^(eDP|LVDS|DSI)")) then "1" else "0" end),
        (.refreshRate | tostring)
      ]
    | @tsv
  '
}

desired_layout_signature() {
  local xpos=0
  local rows=()
  local parts=()

  mapfile -t rows < <(layout_rows)
  if (( ${#rows[@]} == 0 )); then
    return 1
  fi

  for row in "${rows[@]}"; do
    local name width height physical_width physical_height available_modes internal current_refresh native_width native_height selected_mode scale effective_width logical_width
    IFS=$'\t' read -r name width height physical_width physical_height available_modes internal current_refresh <<<"$row"
    IFS=$'\t' read -r native_width native_height <<<"$(native_dimensions_for_modes "$width" "$height" "$available_modes")"
    selected_mode="$(choose_mode_for_monitor "$name" "$native_width" "$native_height" "$physical_width" "$available_modes")"
    scale="$(scale_for_selected_mode "$name" "$native_width" "$physical_width" "$selected_mode")"
    effective_width="$(width_for_mode "$width" "$selected_mode")"
    logical_width="$(logical_width_for_mode "$effective_width" "$scale")"

    local rate_tenths mode_height
    if [[ "$selected_mode" == preferred ]]; then
      mode_height="$native_height"
      rate_tenths="$(awk -v rate="$current_refresh" 'BEGIN {printf "%.0f", rate * 10}')"
    else
      mode_height="$(cut -dx -f2 <<<"${selected_mode%%@*}")"
      rate_tenths="$(awk -v rate="${selected_mode#*@}" 'BEGIN {printf "%.0f", rate * 10}')"
    fi
    parts+=("$name:$xpos:0:$scale:$effective_width:$mode_height:$rate_tenths")
    xpos=$((xpos + logical_width))
  done

  printf '%s\n' "${parts[@]}" | LC_ALL=C sort | paste -sd'|' -
}

apply_layout() {
  local action="${1:-apply}"
  local xpos=0
  local rows=()
  local rules=()

  mapfile -t rows < <(layout_rows)
  if (( ${#rows[@]} == 0 )); then
    log_warning "No active monitors detected"
    return 1
  fi

  for row in "${rows[@]}"; do
    local name width height physical_width physical_height available_modes internal current_refresh native_width native_height selected_mode scale spec effective_width logical_width
    IFS=$'\t' read -r name width height physical_width physical_height available_modes internal current_refresh <<<"$row"
    IFS=$'\t' read -r native_width native_height <<<"$(native_dimensions_for_modes "$width" "$height" "$available_modes")"
    selected_mode="$(choose_mode_for_monitor "$name" "$native_width" "$native_height" "$physical_width" "$available_modes")"
    scale="$(scale_for_selected_mode "$name" "$native_width" "$physical_width" "$selected_mode")"
    spec="hl.monitor({output=$(jq -Rn --arg value "$name" '$value'),mode=$(jq -Rn --arg value "${selected_mode%Hz}" '$value'),position=\"${xpos}x0\",scale=$scale})"
    effective_width="$(width_for_mode "$width" "$selected_mode")"
    logical_width="$(logical_width_for_mode "$effective_width" "$scale")"
    rules+=("$spec")

    if [[ "$action" == "dry-run" ]]; then
      printf 'hyprctl eval %q\n' "$spec"
    else
      log_info "Applying monitor layout: $spec"
      local result
      result="$(hyprctl eval "$spec")" || return 1
      [[ "$result" == ok ]] || { log_error "$result"; return 1; }
    fi

    xpos=$((xpos + logical_width))
  done

  if [[ "$action" != "dry-run" ]]; then
    write_runtime_monitor_conf "${rules[@]}"
  fi
}

acquire_owner() {
  : "${XDG_RUNTIME_DIR:?A real user session is required}"
  [[ "$(stat -c '%u:%a' "$XDG_RUNTIME_DIR")" == "$(id -u):700" ]] || return 1
  [[ ! -L "$XDG_RUNTIME_DIR/dynamic-monitors.lock" ]] || return 1
  exec 9>"$XDG_RUNTIME_DIR/dynamic-monitors.lock"
  flock -n 9 || { log_error 'Another monitor owner holds the lock'; return 1; }
  # Unknown checkout instances do not share this lock: require quiescent cutover.
  local pid arg
  for pid in /proc/[0-9]*; do
    [[ "${pid##*/}" != "$$" && -r "$pid/cmdline" && -O "$pid" ]] || continue
    while IFS= read -r -d '' arg; do
      if [[ "${arg##*/}" == dynamic-monitors ]]; then
        log_error "Existing monitor process ${pid##*/} requires approved cutover"
        return 1
      fi
    done < "$pid/cmdline" || true
  done
}

watch_layout() {
  [[ "${INVOCATION_ID:-}" ]] || { log_error 'Start through dynamic-monitors.service'; return 1; }
  acquire_owner
  local last_signature="" last_power_source="" source
  while true; do
    local signature=""
    local desired_signature=""
    local current_signature=""
    source="$(power_source)" || return 1
    if [[ "$source" != "$last_power_source" ]]; then
      power_brightness_transition "$source" || return 1
      last_power_source="$source"
    fi
    signature="$(topology_signature 2>/dev/null || true):$source:$(internal_refresh)"
    desired_signature="$(desired_layout_signature 2>/dev/null || true)"
    current_signature="$(current_layout_signature 2>/dev/null || true)"

    if [[ -n "$signature" && "$signature" != "$last_signature" ]]; then
      log_step "Monitor topology changed; recalculating layout"
      apply_layout apply || log_warning "Failed to apply dynamic monitor layout"
      last_signature="$signature"
    elif [[ -n "$desired_signature" && -n "$current_signature" && "$current_signature" != "$desired_signature" ]]; then
      log_step "Monitor layout drifted; reapplying layout"
      apply_layout apply || log_warning "Failed to apply dynamic monitor layout"
    fi
    sleep "$POLL_SECONDS"
  done
}

status() {
  require_deps
  log_success "hyprctl and jq are available"
  printf 'topology=%s\n' "$(topology_signature)"
}

main() {
  umask 077
  [[ "$POLL_SECONDS" =~ ^[1-9][0-9]*$ ]] || { log_error 'Invalid poll interval'; return 2; }
  local cmd="${1:---watch}"

  case "$cmd" in
    -h|--help)
      usage
      ;;
    --dry-run)
      require_deps
      apply_layout dry-run
      ;;
    --apply)
      require_deps
      acquire_owner
      apply_layout apply
      ;;
    --watch)
      require_deps
      watch_layout
      ;;
    --status)
      status
      ;;
    --suspend-if-battery)
      local source
      if source="$(power_source)" && [[ "$source" == bat ]]; then systemctl suspend; fi
      ;;
    *)
      log_error "Unknown option: $cmd"
      usage >&2
      return 2
      ;;
  esac
}

main "$@"
