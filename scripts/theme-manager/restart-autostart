#!/usr/bin/env bash
set -euo pipefail

# Safer rerun of essential autostart services with idempotency checks.
status=0
if ! "$HOME/.local/bin/dragon-clipboard-session" --restart; then
  printf '%s\n' '[autostart] ERROR: clipboard owner failed; continuing independent services (no fallback)' >&2
  status=1
fi

run_exec() {
  local cmd="$1"
  echo "[autostart] exec: $cmd"
  hyprctl dispatch exec "$cmd" >/dev/null 2>&1 || true
}

start_if_missing() {
  local pname="$1"; shift
  local cmd="$*"
  if ! pgrep -x "$pname" >/dev/null 2>&1; then
    run_exec "$cmd"
  fi
}

restart_proc() {
  local pname="$1"; shift
  local cmd="$*"
  pkill -x "$pname" >/dev/null 2>&1 || true
  # Back-compat cleanup: older versions ran as "bash .../waybar-hoverd", so -x won't match.
  if [[ "$pname" == "waybar-hoverd" ]]; then
    pkill -f "/waybar-hoverd(\\s|$)" >/dev/null 2>&1 || true
  fi
  sleep 0.05
  run_exec "$cmd"
}

polkit_agent_running() {
  pgrep -x hyprpolkitagent >/dev/null 2>&1 \
    || pgrep -x polkit-mate-authentication-agent-1 >/dev/null 2>&1 \
    || pgrep -x polkit-gnome-authentication-agent-1 >/dev/null 2>&1
}

# Background (swww/swaybg)
run_exec "uwsm app -- ~/.local/bin/theme-bg-apply"

# Monitor layout
if command -v systemctl >/dev/null 2>&1 && systemctl --user list-unit-files --type=service 2>/dev/null | grep -q '^dynamic-monitors\.service'; then
  systemctl --user restart dynamic-monitors.service >/dev/null 2>&1 || true
else
  run_exec "$HOME/dotfiles/scripts/theme-manager/dynamic-monitors --apply"
fi

# Waybar
# True show/hide for Waybar is managed by waybar-hoverd
pkill -x waybar >/dev/null 2>&1 || true
if command -v systemctl >/dev/null 2>&1 && systemctl --user list-unit-files --type=service 2>/dev/null | grep -q '^waybar-hoverd\.service'; then
  systemctl --user restart waybar-hoverd.service >/dev/null 2>&1 || true
else
  restart_proc waybar-hoverd "uwsm app -- bash -c 'USE_SIGNALS=0 PREWARM_WAYBAR=0 exec -a waybar-hoverd bash \"$HOME/.local/bin/waybar-hoverd\" --run'"
fi

# Input/IME
start_if_missing fcitx5 "uwsm app -- fcitx5"

# Notifications
if pgrep -x swaync >/dev/null 2>&1; then
  command -v swaync-client >/dev/null 2>&1 && swaync-client -R >/dev/null 2>&1 || true
else
  run_exec "uwsm app -- swaync"
fi

# Audio uses the same guarded native-unit owner as graphical-session startup.
if ! "$HOME/.local/bin/dragon-audio-session"; then
  printf '%s\n' '[autostart] ERROR: audio owner failed; continuing independent services (no fallback daemon)' >&2
  status=1
fi

# Idle daemon
if ! "$HOME/.local/bin/toggle-idle" --start; then
  printf '%s\n' '[autostart] ERROR: idle owner failed; continuing unrelated services (no fallback daemon)' >&2
  status=1
fi

# OSD server
start_if_missing swayosd-server "uwsm app -- swayosd-server"

# Launcher refresh uses the same managed owners; no process-name kill/fork fallback.
systemctl --user stop walker.service
systemctl --user restart elephant.service
systemctl --user start walker.service

# Polkit agent
if ! polkit_agent_running; then
  if command -v systemctl >/dev/null 2>&1 && systemctl --user list-unit-files --type=service 2>/dev/null | grep -q '^polkit-agent\.service'; then
    systemctl --user restart polkit-agent.service >/dev/null 2>&1 || true
  else
    run_exec "$HOME/.local/bin/start-polkit-agent"
  fi
fi

# Gnome keyring
start_if_missing gnome-keyring-daemon "/usr/bin/gnome-keyring-daemon --start --components=pkcs11,secrets,ssh"

# Network applet
start_if_missing nm-applet "nm-applet --indicator"

# WOB pipe + server
if ! pgrep -x wob >/dev/null 2>&1; then
  rm -f /tmp/"${HYPRLAND_INSTANCE_SIGNATURE:-hypr}".wob || true
  run_exec "bash -c 'mkfifo /tmp/$HYPRLAND_INSTANCE_SIGNATURE.wob && tail -f /tmp/$HYPRLAND_INSTANCE_SIGNATURE.wob | wob & disown'"
fi

if (( status == 0 )); then
  echo "Autostart services checked/restarted."
else
  printf '%s\n' '[autostart] ERROR: independent services checked; clipboard/audio/idle owner failure remains' >&2
fi
exit "$status"
