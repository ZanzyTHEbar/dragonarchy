#!/usr/bin/env python3
"""Apply the selected dotfiles palette through Wayle's native TOML import."""
import argparse
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import tomllib

SOURCE_KEYS = ('background', 'foreground', 'comment', 'accent', 'red', 'yellow', 'green', 'blue')


def render(source):
    colors = {}
    for key, value in re.findall(r'^\s*\$(\w+)\s*=\s*([^\n]*)$',
                                 source.read_text(), re.M):
        if key in SOURCE_KEYS:
            if key in colors:
                raise ValueError(f'duplicate palette color: {key}')
            match = re.fullmatch(r'rgba\(([0-9a-fA-F]{8})\)', value.partition('#')[0].strip())
            if not match:
                raise ValueError(f'missing or invalid palette colors: {key}')
            colors[key] = '#' + match[1][:6].lower()
    missing = set(SOURCE_KEYS) - colors.keys()
    if missing:
        raise ValueError(f'missing or invalid palette colors: {", ".join(sorted(missing))}')

    def blend(percent):
        bg = bytes.fromhex(colors['background'][1:])
        fg = bytes.fromhex(colors['foreground'][1:])
        return '#' + ''.join(f'{(a * (100 - percent) + b * percent + 50) // 100:02x}' for a, b in zip(bg, fg))

    palette = dict(bg=colors['background'], surface=blend(5), elevated=blend(10),
                   fg=colors['foreground'], **{'fg-muted': colors['comment']}, primary=colors['accent'],
                   red=colors['red'], yellow=colors['yellow'], green=colors['green'], blue=colors['blue'])
    text = '# Generated by wayle-theme-apply; colors are owned by the dotfiles theme manager.\n'
    text += '[styling.palette]\n' + ''.join(f'{key} = "{value}"\n' for key, value in palette.items())
    return text, palette


def apply(source, config_home):
    text, palette = render(source)
    output = config_home / 'wayle/palette.toml'
    repo = Path(__file__).resolve().parents[2]
    if output.is_symlink() or output.resolve().is_relative_to(repo):
        raise ValueError('Wayle palette must be a runtime-owned file outside the dotfiles checkout')

    config = tomllib.loads((output.parent / 'config.toml').read_text())
    imports = config.get('imports', [])
    if not isinstance(imports, list) or 'palette.toml' not in imports:
        raise ValueError('Wayle config.toml must import the theme-manager-owned palette.toml')

    runtime_file = output.parent / 'runtime.toml'
    runtime = tomllib.loads(runtime_file.read_text()) if runtime_file.exists() else {}
    styling = runtime.get('styling', {})
    if not isinstance(styling, dict) or not isinstance(styling.get('palette', {}), dict):
        raise ValueError('invalid styling table in Wayle runtime.toml')
    overrides = [f'styling.palette.{key}' for key in palette if key in styling.get('palette', {})]
    if 'theme-provider' in styling:
        overrides.insert(0, 'styling.theme-provider')
    if overrides and shutil.which('wayle') is None:
        raise ValueError('Wayle is required to clear its runtime color overrides')

    output.parent.mkdir(parents=True, exist_ok=True)
    if not output.exists() or output.read_text() != text:
        fd, temp = tempfile.mkstemp(prefix='.palette-', dir=output.parent)
        try:
            with os.fdopen(fd, 'w') as stream:
                stream.write(text)
            os.replace(temp, output)
        finally:
            if os.path.exists(temp):
                os.unlink(temp)

    # Use Wayle's own reset API; preserve all unrelated GUI/runtime preferences.
    for field in overrides:
        subprocess.run(['wayle', 'config', 'reset', field], check=True,
                       stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    print(f'Applied Wayle palette from {source.parent.name}')


def main():
    config_home = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config')))
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('palette', nargs='?', type=Path,
                        default=config_home / 'current/theme/hyprland-palette.conf')
    args = parser.parse_args()
    try:
        apply(args.palette, config_home)
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print(f'Cannot apply Wayle theme: {error}', file=sys.stderr)
        if isinstance(error, subprocess.CalledProcessError) and error.stderr:
            print(error.stderr.strip(), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
