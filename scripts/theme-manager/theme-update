#!/usr/bin/env bash
# User-only public update; leave runtime theme/background choices untouched.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$SOURCE" ]]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" == /* ]] || SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

for arg in "$@"; do
    case "$arg" in
        --system-only)
            echo 'theme-update only supports user state; --system-only is not allowed.' >&2
            exit 2
            ;;
        -h|--help)
            echo 'Usage: theme-update --host <inventory host> --user <managed user> [installer options]'
            echo 'Runs public update with --user-only. Refreshes repository theme assets, not live selections.'
            echo 'Remote user convergence does not deliver repository-only theme assets to remote hosts.'
            echo 'No theme/background reselection, history changes, generated palette rewrite, or live reapply.'
            exit 0
            ;;
    esac
done
exec "$SCRIPT_DIR/../install/update.sh" --user-only "$@"
