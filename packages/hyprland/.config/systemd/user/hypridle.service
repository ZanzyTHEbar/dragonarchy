[Unit]
Description=Dragon single per-user idle owner
Documentation=https://wiki.hypr.land/Hypr-Ecosystem/hypridle/
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=exec
Environment=DRAGON_IDLE_OWNER=1
Environment=XDG_RUNTIME_DIR=%t
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/toggle-idle --run
TimeoutStopSec=10
KillMode=control-group
UMask=0077
# No automatic retry of an unknown owner, and no independent enablement path.
# The compositor session entry requests --start after importing its environment.
