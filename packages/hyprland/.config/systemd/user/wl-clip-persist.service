[Unit]
Description=Dragon wl-clip-persist 0.5.0 regular clipboard owner
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=exec
Environment=DRAGON_CLIPBOARD_OWNER=persist
Environment=XDG_RUNTIME_DIR=%t
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/dragon-clipboard-session --run persist
KillMode=control-group
TimeoutStopSec=10
UMask=0077
