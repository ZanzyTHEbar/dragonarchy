[Desktop Entry]
Version=1.0
Name=About
Comment=System information from Fastfetch
Exec=kitty --class=About --title=About -o remember_window_size=no -o initial_window_width=150c -o initial_window_height=50c -e dragon-cli about --wait
Terminal=false
Type=Application
Icon=dragon-control
Categories=System;
StartupNotify=false
