{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-luna#xhigh",
  "default_agent": "plan",
  "provider": {
    "github-copilot": {
      "options": {
        "baseURL": "http://127.0.0.1:17321/v1",
        "headers": {
          "sleeve-harness": "opencode",
          "sleeve-provider": "copilot"
        }
      }
    },
    "google": {
      "options": {
        "baseURL": "http://127.0.0.1:17321",
        "headers": {
          "sleeve-harness": "opencode",
          "sleeve-provider": "google"
        }
      }
    },
    "openai": {
      "options": {
        "baseURL": "http://127.0.0.1:17321/v1",
        "headers": {
          "sleeve-harness": "opencode",
          "sleeve-provider": "openai"
        }
      }
    },
    "openrouter": {
      "options": {
        "baseURL": "http://127.0.0.1:17321/v1",
        "headers": {
          "sleeve-harness": "opencode",
          "sleeve-provider": "openrouter"
        }
      }
    },
    "opencode": {
      "options": {
        "baseURL": "http://127.0.0.1:17321/v1",
        "headers": {
          "sleeve-harness": "opencode",
          "sleeve-provider": "opencode"
        }
      }
    },
    "opencode-go": {
      "options": {
        "baseURL": "http://127.0.0.1:17321/v1",
        "headers": {
          "sleeve-harness": "opencode",
          "sleeve-provider": "opencode-go"
        }
      }
    },
    "xai": {
      "options": {
        "baseURL": "http://127.0.0.1:17321/v1",
        "headers": {
          "sleeve-harness": "opencode",
          "sleeve-provider": "xai"
        }
      }
    }
  },
  // Performance & UX
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 40000
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", "build/**"]
  },
  "lsp": true,
  "autoupdate": true,
  "experimental": {
    "disable_paste_summary": true
  },
  "instructions": [
    "./AGENTS.md"
  ],
  "mcp": {
    //dev"actualbudget": {
    //  "type": "remote",
    //  "url": "https://mcp.zacariahheim.com/actualbudget/mcp",
    //  "oauth": {
    //    "scope": "mcp:actualbudget"
    //  }
    //},
    //"mealie": {
    //  "type": "remote",
    //  "url": "https://mcp.zacariahheim.com/mealie/mcp",
    //  "oauth": {
    //    "scope": "mcp:mealie"
    //  }
    //},
    //"memory-kg": {
    //  "type": "remote",
    //  "url": "https://mcp.zacariahheim.com/memory/mcp",
    //  "oauth": {
    //    "scope": "mcp:memory"
    //  },
    //  "timeout": 20000
    //},
    "allpepper-memory-bank": {
      "type": "remote",
      "url": "https://mcp.zacariahheim.com/allpepper-memory-bank/mcp",
      "oauth": {
        "scope": "mcp:allpepper-memory-bank"
      },
      "timeout": 20000
    },
    "saga": {
      "type": "remote",
      "url": "https://mcp.zacariahheim.com/saga/mcp",
      "oauth": {
        "scope": "mcp:saga"
      },
      "timeout": 20000
    },
    "penpot": {
      "type": "remote",
      "url": "https://mcp.zacariahheim.com/penpot/mcp",
      "oauth": {
        "scope": "mcp:penpot"
      },
      "timeout": 20000
    },
    "codebase-memory": {
      "type": "local",
      "command": ["sh", "-c", "exec \"$HOME/.local/bin/codebase-memory-mcp\""],
      "enabled": true,
      "timeout": 300000
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@0.0.75"],
      "enabled": true,
      "timeout": 20000
    },
    "browser-use": {
      "type": "local",
      "enabled": true,
      "command": ["uvx", "--from", "browser-use[cli]", "browser-use", "--mcp"],
      "timeout": 60000
    }
  },
  "plugin": [
    "{env:HOME}/.local/share/opencode/ponytail/.opencode/plugins/ponytail.mjs"
  ],
  "skills": {
    "paths": [
      "{env:HOME}/.local/share/opencode/ponytail/skills",
      "{env:HOME}/.opencode/personal",
      "{env:HOME}/.config/opencode/skills"
    ]
  },
  "permission": {
   "lsp": "allow"
  }
}
