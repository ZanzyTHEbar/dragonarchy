[Unit]
Description=Dynamic Hyprland monitor layout helper
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=exec
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin
ExecStart=%h/.local/bin/dynamic-monitors --watch
Environment=MONITOR_LAYOUT_POLL_SECONDS=5
UMask=0077
TimeoutStopSec=10

# The existing graphical environment importer requests this owner.
