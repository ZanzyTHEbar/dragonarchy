[Unit]
Description=Dragon Elephant 2.22.1 backend (single managed owner)
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=exec
Environment=XDG_RUNTIME_DIR=%t
Environment=PATH=/usr/local/bin:%h/.local/bin:/usr/bin:/bin
Environment="XDG_DATA_DIRS=%h/.local/share:%h/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share"
ExecStart=/usr/local/bin/elephant --managed-server
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
KillMode=control-group
UMask=0077

# Started only after the compositor imports its real session environment.
# No ExecStartPre/ExecStopPost socket deletion or readiness-probe process.
