#!/usr/bin/env python3
"""Canonical theme publication/recovery; explicit live subcommands refresh sessions."""

from contextlib import ExitStack
import configparser
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import runpy
import shutil
import stat
import subprocess
import sys
import tempfile


def palette(path):
    if not stat.S_ISREG(path.lstat().st_mode):
        raise ValueError(f'Palette must be a regular file: {path}')
    data = path.read_bytes()
    keys = set()
    # Canonical renderers use awk's $1/$3 fields, not a Hyprland parser.
    # Do not normalize Unicode whitespace/line separators that awk won't read.
    for line in data.decode().split('\n'):
        line = line.split('#', 1)[0].strip(' \t')
        if not line:
            continue
        match = re.fullmatch(r'\$([A-Za-z_][A-Za-z0-9_]*)[ \t]+=[ \t]+rgba\(([0-9a-fA-F]{6}|[0-9a-fA-F]{8})\)', line)
        if not match or match[1] in keys:
            raise ValueError(f'Unsupported or duplicate palette declaration in {path}: {line}')
        keys.add(match[1])
    if not {'background', 'foreground', 'accent', 'green', 'comment', 'yellow'} <= keys:
        raise ValueError(f'Missing required compositor colors: {path}')
    return data


def lua_palette(data):
    # Validated theme DATA, never executable compositor input. Emit hex only.
    colors = re.findall(rb'(?m)^[ \t]*\$([A-Za-z_][A-Za-z0-9_]*)[ \t]+=[ \t]+rgba\(([0-9a-fA-F]{6}|[0-9a-fA-F]{8})\)', data)
    return (b'-- Generated by theme-bootstrap; edits are replaced.\nreturn {\n' +
            b''.join(b'    ["' + key + b'"] = "#' + value + b'",\n'
                     for key, value in colors) + b'}\n')


def directory(path, create=True):
    for parent in (*reversed(path.parents), path):
        if parent.is_symlink() or (parent.exists() and not parent.is_dir()):
            raise ValueError(f'Runtime directory must not redirect writes: {parent}')
    if create:
        path.mkdir(parents=True, exist_ok=True)


def assets(root):
    entries = {}
    for path in (root, *root.rglob('*')):
        # External themes are data, never Git internals/hooks in a generation.
        if '.git' in path.relative_to(root).parts:
            continue
        mode = path.lstat().st_mode
        if not (stat.S_ISREG(mode) or stat.S_ISDIR(mode)):
            raise ValueError(f'Unsupported theme asset: {path}')
        entries[path.relative_to(root)] = (stat.S_IFMT(mode), stat.S_IMODE(mode))
    return entries


def theme_sources(config):
    """Qualified IDs retain both sources; plain slugs prefer personal themes."""
    result = {}
    for origin, root in (('shipped', config / 'dragon/theme-inputs'), ('personal', config / 'themes')):
        if not root.exists():
            continue
        for path in sorted(root.iterdir()):
            if (re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_-]*', path.name) and
                    path.is_dir() and (path / 'hyprland-palette.conf').is_file()):
                result[f'{origin}:{path.name}'] = path
                result[path.name] = path
    return result


def gtk_settings(base, overlay):
    parser = configparser.RawConfigParser(strict=False)
    parser.optionxform = str
    parser.read_string(base.decode())
    parser.read_string(overlay.decode())
    if not parser.has_section('Settings'):
        parser.add_section('Settings')
    # Match the former live helper's installed-theme protection, not a guessed
    # package/theme provider. Personal base bytes remain untouched.
    name = parser.get('Settings', 'gtk-theme-name', fallback='')
    if name and not any((root / name).is_dir() for root in (
            Path.home() / '.local/share/themes', Path.home() / '.themes',
            Path('/usr/local/share/themes'), Path('/usr/share/themes'))):
        parser.set('Settings', 'gtk-theme-name', 'Adwaita')
    import io
    output = io.StringIO()
    parser.write(output, space_around_delimiters=False)
    return output.getvalue().encode()


def identity(root, renderers, bases):
    digest = hashlib.sha256()
    digest.update(Path(__file__).read_bytes())
    for name, (kind, mode) in sorted(assets(root).items()):
        digest.update(f'{name}\0{kind}\0{mode}\0'.encode())
        if kind == stat.S_IFREG:
            digest.update((root / name).read_bytes())
    for renderer in renderers:
        if not stat.S_ISREG(renderer.lstat().st_mode):
            raise ValueError(f'Renderer must be a regular file: {renderer}')
        digest.update(renderer.read_bytes())
    for base in bases:
        if not stat.S_ISREG(base.lstat().st_mode) or not base.read_bytes():
            raise ValueError(f'Missing regular structural base: {base}')
        digest.update(f'{base.name}\0{stat.S_IMODE(base.stat().st_mode)}\0'.encode())
        digest.update(base.read_bytes())
    return digest.hexdigest()


def regular(path):
    if path.is_symlink() and not path.exists():
        raise ValueError(f'Dangling runtime path: {path}')
    if path.exists() and not path.is_file():
        raise ValueError(f'Conflicting runtime path: {path}')


def waybar_colors(path, palette_path):
    if not path.exists() and not path.is_symlink():
        colors = {}
        for line in palette(palette_path).decode().split('\n'):
            match = re.fullmatch(r'\$(background|foreground)[ \t]+=[ \t]+rgba\(([0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?)\)', line.split('#', 1)[0].strip(' \t'))
            if match:
                colors[match[1]] = match[2]
        declarations = []
        for name in ('background', 'foreground'):
            value = colors[name]
            # Waybar's structural stylesheet owns opacity; palette fallback
            # supplies the same opaque RGB named roles as shipped color assets.
            color = '#' + value[:6]
            declarations.append(f'@define-color {name} {color};\n')
        return ''.join(declarations).encode()
    if not stat.S_ISREG(path.lstat().st_mode):
        raise ValueError(f'Waybar colors must be a regular file: {path}')
    data = path.read_bytes()
    # Shipped assets are named hex colors with optional C comments, not general CSS.
    css = re.sub(r'/\*.*?\*/', '', data.decode(), flags=re.S)
    names = set()
    for declaration in css.split(';')[:-1]:
        match = re.fullmatch(r'\s*@define-color\s+([A-Za-z_][A-Za-z0-9_-]*)\s+#[0-9a-fA-F]{6}\s*', declaration)
        if not match or match[1] in names:
            raise ValueError(f'Unsupported Waybar color declaration: {path}')
        names.add(match[1])
    if css.split(';')[-1].strip() or not {'background', 'foreground'} <= names:
        raise ValueError(f'Missing required Waybar colors: {path}')
    return data


def prepare(config, mode, slug, *, metadata=None, history_generation=None, live_settings=False):
    # Do not reinterpret, overwrite or silently abandon incumbent compositor
    # inputs. Their explicit quiescent cutover is separate from publication.
    for relative in ('hyprland.conf', 'colors-theme.conf',
                     'config/monitor.local.conf', 'config/keyboard.local.conf',
                     'config/user-config.conf', 'config/host-config.conf'):
        incumbent = config / 'hypr' / relative
        if incumbent.exists() or incumbent.is_symlink():
            raise ValueError(f'Obsolete Hyprlang compositor input remains: {incumbent}. '
                             'Preserve/archive it during an approved quiescent cutover and '
                             'declare retained overrides in hypr/local/*.lua before retrying; '
                             'automatic translation or fallback is not supported')
    inputs = config / 'dragon/theme-inputs'
    current = config / 'current/theme'
    colors = config / 'hypr/colors-theme.lua'
    wallpaper = config / 'theme-manager/wallpaper.conf'
    snapshots = config / 'current/.theme-snapshots'
    published_palette = config / 'current/.published-palette'
    swaync_provenance = config / 'current/.swaync-base-source'
    outputs = {colors: 'hyprland-colors.lua', config / 'kitty/colors.conf': 'kitty.conf',
               config / 'gtk-3.0/gtk.css': 'gtk-3.0/gtk.css',
               config / 'gtk-4.0/gtk.css': 'gtk-4.0/gtk.css',
               config / 'btop/themes/current.theme': 'btop.theme',
               config / 'swaync/style.css': 'swaync.css',
               config / 'clipse/custom_theme.json': 'clipse.json',
               config / 'walker/themes/current/style.css': 'walker.css',
               config / 'waybar/colors-theme.css': 'waybar.css'}
    if live_settings:
        for version in ('3.0', '4.0'):
            outputs[config / f'gtk-{version}/settings.ini'] = f'gtk-{version}/settings.live.ini'
        outputs[config / 'zsh/autosuggest-theme.zsh'] = 'zsh.live'
        outputs[config / 'wlogout/wlogout.css'] = 'wlogout.live'
    preferences = {wallpaper: config / 'dragon/wallpaper.defaults.conf',
                   config / 'btop/btop.conf': config / 'dragon/btop.defaults.conf',
                   config / 'gtk-3.0/settings.base.ini': config / 'dragon/gtk-3.0.defaults.ini',
                   config / 'gtk-4.0/settings.base.ini': config / 'dragon/gtk-4.0.defaults.ini',
                   config / 'clipse/config.json': config / 'dragon/clipse.defaults.json',
                   config / 'elephant/websearch.toml': config / 'dragon/elephant-websearch.defaults.toml',
                   config / 'elephant/clipboard.toml': config / 'dragon/elephant-clipboard.defaults.toml'}
    for name in ('monitor', 'keyboard', 'user', 'host'):
        preferences[config / f'hypr/local/{name}.lua'] = config / f'hypr/defaults/{name}.lua'
    runtime_roots = {path.parent for path in (*outputs, *preferences, current, published_palette)}
    runtime_roots.update(path.parent for path in (metadata or {}))
    runtime_roots.add(snapshots)
    directory(snapshots, create=False)
    try:
        with os.scandir(snapshots) as entries:
            if any(entry.name.startswith('.recovery-') for entry in entries):
                raise ValueError(f'Unresolved theme recovery exists in {snapshots}; inspect it before retrying')
    except FileNotFoundError:
        pass
    if published_palette.is_symlink():
        raise ValueError('Published palette identity must not be a symlink')
    regular(published_palette)
    if swaync_provenance.is_symlink():
        raise ValueError('SwayNC base provenance must not be a symlink')
    regular(swaync_provenance)
    # Automatic convergence must neither consult nor create interactive history.
    if mode != 'bootstrap':
        state = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state')))
        if not state.is_absolute() or '..' in state.parts:
            raise ValueError('XDG_STATE_HOME must be absolute without parent traversal')
        state = state / 'dragon/theme-manager'
        directory(state, create=False)
        history = [state / name for name in ('prev-theme', 'recent-themes', 'previous-generation')]
        runtime_roots.update(path.parent for path in history)
        for path in history:
            if path.is_symlink():
                raise ValueError(f'History must not be a symlink: {path}')
            regular(path)
    renderer_dir = Path(__file__).resolve().parent.parent / 'libexec/dragon/theme-manager'
    renderers = [renderer_dir / name for name in (
        'generate-kitty-themes', 'generate-gtk-themes', 'generate-btop-themes',
        'generate-swaync-themes', 'generate-clipse-themes', 'generate-walker-themes', 'lib/theme-utils.sh')]
    swaync_base = config / 'swaync/style-base.css'
    # Share the renderer's explicit structural-input override; the managed
    # installation retains its release-specific default.
    walker_base = Path(os.environ.get('WALKER_BASE', '/usr/local/share/dragon-launcher/walker-2.17.2.css'))
    prepared = None
    provenance = None
    try:
        selection = current.lstat()
    except FileNotFoundError:
        selection = None
    old = None
    if selection is not None:
        if not stat.S_ISLNK(selection.st_mode):
            raise ValueError(f'Unsupported selection (expected a symlink): {current}')
        old = os.readlink(current)
        if not os.path.samestat(selection, current.lstat()):
            raise ValueError(f'Theme selection changed during preparation: {current}')
        selected = (current.parent / old).resolve(strict=True)
        active_palette = lua_palette(palette(selected / 'hyprland-palette.conf'))
        if (mode == 'bootstrap' and colors.exists() and colors.is_file() and
                colors.read_bytes() != active_palette and not (
                    published_palette.is_file() and published_palette.read_text() ==
                    hashlib.sha256(colors.read_bytes()).hexdigest())):
            raise ValueError(f'Conflicting selected theme and compositor palette: {colors}')
        # Only our own snapshots carry source provenance. Never infer identity
        # from a familiar basename: an external tokyo-night may be customized.
        if selected.parent.parent == snapshots:
            prepared = selected
            source = selected.parent / 'source'
            if source.is_symlink() or not source.is_file():
                raise ValueError(f'Unsupported snapshot provenance: {source}')
            provenance = source.read_text()
            selected = Path(provenance)
            if not selected.is_absolute():
                raise ValueError(f'Snapshot source must be absolute: {source}')
    else:
        if colors.exists() or colors.is_symlink():
            raise ValueError(f'Palette exists without a theme selection: {colors}')
        if mode == 'bootstrap':
            for path in (*outputs, published_palette, swaync_provenance):
                if path.exists() or path.is_symlink():
                    raise ValueError(f'Theme output exists without a theme selection: {path}')
        selected = inputs / 'tokyo-night'
    initial_bootstrap = mode == 'bootstrap' and selection is None
    old_generation = history_generation if history_generation is not None else prepared
    if mode != 'bootstrap' and old is not None and prepared is None:
        raise ValueError('Run theme-bootstrap to capture the external selection before set/undo')
    undo = None
    if mode in ('set', 'preview'):
        choices = theme_sources(config)
        if slug not in choices:
            raise ValueError(f'Unknown installed theme: {slug}')
        selected = choices[slug]
    elif mode in ('undo', 'restore', 'commit'):
        undo = Path(history[2].read_text()) if mode == 'undo' else Path(slug)
        if not undo.is_absolute() or undo.parent.parent != snapshots or undo.is_symlink():
            raise ValueError('Unsupported previous generation')
        assets(undo)
        selected = Path((undo.parent / 'source').read_text())
        if not selected.is_absolute():
            raise ValueError('Previous source must be absolute')
    selected = selected.resolve(strict=undo is None)
    if (undo is None and not selected.is_dir()) or not re.fullmatch(r'[\w.-]+', selected.name):
        raise ValueError(f'Unsupported theme selection: {selected}')
    # Protect every publication/default destination, not only compositor paths.
    # Reject before creating destination directories or renderer staging files.
    for runtime in runtime_roots:
        if selected == runtime or selected in runtime.parents or runtime in selected.parents:
            raise ValueError(f'Theme source overlaps runtime preparation: {selected}')
    for parent in runtime_roots:
        directory(parent)
    source = undo if undo is not None else selected
    data = palette(source / 'hyprland-palette.conf')
    fingerprint = None if undo is not None else identity(selected, renderers, [swaync_base, walker_base])
    unchanged = (prepared is not None and provenance == str(selected) and
                 (prepared.parent / 'identity').is_file() and
                 (prepared.parent / 'identity').read_text() == fingerprint)
    if undo is not None:
        unchanged = undo == prepared
    for path in (*outputs, *preferences, *(metadata or {})):
        directory(path.parent)
        regular(path)
    defaults = {path: source.read_bytes() for path, source in preferences.items() if not path.exists()}
    # Validate everything before publication. Keep snapshots for recovery; each
    # ends in the actual slug for existing basename-based theme consumers.
    recovery_dirs = []
    recovery_root = None
    manifest = None
    manifest_path = None
    retain_recovery = False
    published_success = False

    def mark_recovery(status):
        nonlocal manifest
        updated = {**manifest, 'status': status}
        fd, temporary_manifest = tempfile.mkstemp(prefix='.manifest-', dir=recovery_root)
        with os.fdopen(fd, 'w', encoding='utf-8') as stream:
            os.fchmod(stream.fileno(), 0o600)
            json.dump(updated, stream, ensure_ascii=True, indent=2)
            stream.write('\n')
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary_manifest, manifest_path)
        manifest = updated

    def finish_recovery(exc_type, exc, traceback):
        if retain_recovery or (exc_type is not None and published_success):
            state = manifest.get('status', 'unrecorded') if manifest is not None else 'unrecorded'
            print(f'theme-bootstrap: recovery retained at {recovery_root} (status {state}); '
                  'inspect manifest.json and destinations before retrying', file=sys.stderr)
            return False
        marker = None
        state = manifest.get('status') if manifest is not None else None
        if state in ('committed', 'rolled-back'):
            try:
                mark_recovery(state + '-cleanup')
                marker = snapshots / (recovery_root.name + '.cleanup')
                os.link(manifest_path, marker)
            except OSError as error:
                original_error = f' Original error: {exc}' if exc is not None else ''
                print(f'theme-bootstrap: {state}; cleanup not started; preserve all backups and inspect '
                      f'{manifest_path}: {error}.{original_error}', file=sys.stderr)
                raise
        try:
            for recovery_dir in reversed(recovery_dirs):
                shutil.rmtree(recovery_dir)
            if recovery_root is not None:
                shutil.rmtree(recovery_root)
            if marker is not None:
                marker.unlink()
        except OSError:
            original_error = f' Original error: {exc}' if exc is not None else ''
            print(f'theme-bootstrap: {state or "pre-publication"}; cleanup incomplete; '
                  f'some staging directories may already be removed. Inspect status record {marker or manifest_path} '
                  f'and remaining staging directories before retrying.{original_error}',
                  file=sys.stderr)
            raise
        return False

    # Cleanup of rendering and destination-local scratch must finish before
    # deciding whether pre-publication backups are safe to remove.
    with ExitStack() as recovery_cleanup, tempfile.TemporaryDirectory(prefix='.prepare-', dir=current.parent) as temporary:
        recovery_cleanup.push(finish_recovery)
        stage = Path(temporary)
        tree = stage / selected.name
        if not unchanged and undo is None:
            shutil.copytree(selected, tree, symlinks=True, ignore=shutil.ignore_patterns('.git'))
            assets(tree)
            if palette(tree / 'hyprland-palette.conf') != data:
                raise ValueError('Palette changed during preparation')
            (stage / 'source').write_text(str(selected))
            (stage / 'identity').write_text(fingerprint)
            # Retain exact source assets separately from generated output.
            shutil.copytree(tree, stage / 'input')
            shutil.copy2(swaync_base, stage / 'style-base.css')
            shutil.copy2(walker_base, stage / walker_base.name)
            # Renderers need filesystem roots and ordinary command lookup, not
            # shell startup hooks, desktop/session credentials or GUI endpoints.
            environment = {key: os.environ[key] for key in (
                'HOME', 'PATH', 'LANG', 'LC_ALL', 'TMPDIR', 'XDG_CONFIG_HOME',
                'XDG_STATE_HOME', 'XDG_CACHE_HOME', 'XDG_DATA_HOME', 'XDG_RUNTIME_DIR')
                if key in os.environ}
            # Only the selected slug is present under this renderer root.
            render_root = stage / 'render'
            render_root.mkdir()
            tree.rename(render_root / selected.name)
            tree = render_root / selected.name
            environment['THEMES_DIR'] = str(render_root)
            environment['SWAYNC_BASE'] = str(stage / 'style-base.css')
            environment['WALKER_BASE'] = str(stage / walker_base.name)
            # Never accept a stale shipped btop asset as successful generation.
            (tree / 'btop.theme').unlink(missing_ok=True)
            (tree / 'swaync.css').unlink(missing_ok=True)
            (tree / 'clipse.json').unlink(missing_ok=True)
            (tree / 'walker.css').unlink(missing_ok=True)
            for renderer in renderers[:-1]:
                subprocess.run([str(renderer)], env=environment, check=True,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            (tree / 'waybar.css').write_bytes(waybar_colors(tree / 'waybar.css', tree / 'hyprland-palette.conf'))
            assets(tree)
            if (identity(stage / 'input', renderers, [stage / 'style-base.css', stage / walker_base.name]) != fingerprint or
                    identity(selected, renderers, [swaync_base, walker_base]) != fingerprint):
                raise ValueError('Theme inputs changed during rendering')
        ready = prepared if unchanged else (undo if undo is not None else tree)
        # Compatibility is publication-only: do not mutate retained snapshots or
        # consult today's external source for a palette-only historical theme.
        waybar = waybar_colors(ready / 'waybar.css', ready / 'hyprland-palette.conf')
        btop = ready / 'btop.theme'
        if (unchanged or undo is not None) and not btop.exists():
            # Older retained generations have no btop output. Render ONLY that
            # output from their retained palette; never edit historical snapshots
            # or regenerate their exact compositor/Kitty/GTK bytes from new input.
            retained_root = stage / 'retained'
            retained = retained_root / ready.name
            retained.mkdir(parents=True)
            (retained / 'hyprland-palette.conf').write_bytes(palette(ready / 'hyprland-palette.conf'))
            environment = {key: os.environ[key] for key in (
                'HOME', 'PATH', 'LANG', 'LC_ALL', 'TMPDIR', 'XDG_CONFIG_HOME',
                'XDG_STATE_HOME', 'XDG_CACHE_HOME', 'XDG_DATA_HOME', 'XDG_RUNTIME_DIR')
                if key in os.environ}
            environment['THEMES_DIR'] = str(retained_root)
            subprocess.run([str(renderers[2])], env=environment, check=True,
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            btop = retained / 'btop.theme'
        swaync = ready / 'swaync.css'
        # A retained base outside the theme/input trees identifies our complete
        # output. Older generations may contain inherited colors-only assets.
        retained_base = ready.parent / 'style-base.css'
        if not unchanged and undo is None:
            retained_base = stage / 'style-base.css'
        base = retained_base if retained_base.exists() else swaync_base
        if not stat.S_ISREG(base.lstat().st_mode) or not base.read_bytes():
            raise ValueError(f'Missing regular SwayNC structural base: {base}')
        if (unchanged or undo is not None) and (not retained_base.exists() or not swaync.exists()):
            retained_root = stage / 'retained-swaync'
            retained = retained_root / ready.name
            retained.mkdir(parents=True)
            (retained / 'hyprland-palette.conf').write_bytes(palette(ready / 'hyprland-palette.conf'))
            environment = {key: os.environ[key] for key in (
                'HOME', 'PATH', 'LANG', 'LC_ALL', 'TMPDIR', 'XDG_CONFIG_HOME',
                'XDG_STATE_HOME', 'XDG_CACHE_HOME', 'XDG_DATA_HOME', 'XDG_RUNTIME_DIR')
                if key in os.environ}
            environment.update(THEMES_DIR=str(retained_root), SWAYNC_BASE=str(base))
            subprocess.run([str(renderers[3])], env=environment, check=True,
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            swaync = retained / 'swaync.css'
        clipse = ready / 'clipse.json'
        if (unchanged or undo is not None) and not clipse.exists():
            # Older generations predate Clipse publication. Render only this
            # consumer from their retained palette, preserving every old asset.
            retained_root = stage / 'retained-clipse'
            retained = retained_root / ready.name
            retained.mkdir(parents=True)
            (retained / 'hyprland-palette.conf').write_bytes(palette(ready / 'hyprland-palette.conf'))
            environment = {key: os.environ[key] for key in (
                'HOME', 'PATH', 'LANG', 'LC_ALL', 'TMPDIR', 'XDG_CONFIG_HOME',
                'XDG_STATE_HOME', 'XDG_CACHE_HOME', 'XDG_DATA_HOME', 'XDG_RUNTIME_DIR')
                if key in os.environ}
            environment['THEMES_DIR'] = str(retained_root)
            subprocess.run([str(renderers[4])], env=environment, check=True,
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            clipse = retained / 'clipse.json'
        if not stat.S_ISREG(clipse.lstat().st_mode):
            raise ValueError(f'Clipse theme must be a regular file: {clipse}')
        clipse_data = json.loads(clipse.read_bytes())
        if (not isinstance(clipse_data, dict) or clipse_data.get('useCustom') is not True or
                not {'TitleFore', 'TitleBack', 'NormalTitle', 'SelectedTitle', 'PreviewBorder'} <= clipse_data.keys() or
                any(not isinstance(value, str) or not re.fullmatch(r'#[0-9a-fA-F]{6}', value)
                    for key, value in clipse_data.items() if key != 'useCustom')):
            raise ValueError(f'Unsupported Clipse theme: {clipse}')
        walker = ready / 'walker.css'
        if (unchanged or undo is not None) and (not walker.exists() or not (ready.parent / walker_base.name).is_file()):
            # Legacy snapshots contain inherited CSS/layout.toml, not proof of
            # this runtime's structure. Adapt only Walker from the retained palette.
            retained_root = stage / 'retained-walker'
            retained = retained_root / ready.name
            retained.mkdir(parents=True)
            (retained / 'hyprland-palette.conf').write_bytes(palette(ready / 'hyprland-palette.conf'))
            environment = {key: os.environ[key] for key in (
                'HOME', 'PATH', 'LANG', 'LC_ALL', 'TMPDIR', 'XDG_CONFIG_HOME',
                'XDG_STATE_HOME', 'XDG_CACHE_HOME', 'XDG_DATA_HOME', 'XDG_RUNTIME_DIR')
                if key in os.environ}
            environment.update(THEMES_DIR=str(retained_root), WALKER_BASE=str(walker_base))
            subprocess.run([str(renderers[5])], env=environment, check=True,
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            walker = retained / 'walker.css'
        publications = {}
        for path, relative in outputs.items():
            if relative == 'hyprland-colors.lua':
                publications[path] = lua_palette(data)
                continue
            if relative.endswith('/settings.live.ini'):
                version = relative.split('/')[0]
                base = config / version / 'settings.base.ini'
                content = base.read_bytes() if base.exists() else preferences[base].read_bytes()
                publications[path] = gtk_settings(content, (ready / version / 'settings.ini').read_bytes())
                continue
            if relative == 'zsh.live':
                match = re.search(rb'(?m)^[ \t]*\$accent[ \t]+=[ \t]+rgba\(([0-9a-fA-F]{6})', data)
                publications[path] = b'export ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE=fg=#' + match[1] + b'\n'
                continue
            if relative == 'wlogout.live':
                asset = ready / 'wlogout.css'
                if not asset.exists():
                    continue  # No theme asset: preserve existing personal consumer state.
                if not stat.S_ISREG(asset.lstat().st_mode):
                    raise ValueError(f'Wlogout theme must be a regular file: {asset}')
                publications[path] = asset.read_bytes()
                continue
            if relative == 'waybar.css':
                publications[path] = waybar
                continue
            asset = (btop if relative == 'btop.theme' else swaync if relative == 'swaync.css'
                     else clipse if relative == 'clipse.json' else walker if relative == 'walker.css' else ready / relative)
            if not stat.S_ISREG(asset.lstat().st_mode) or not asset.read_bytes():
                raise ValueError(f'Missing rendered output: {asset}')
            publications[path] = asset.read_bytes()
        publications[published_palette] = hashlib.sha256(publications[colors]).hexdigest().encode()
        base_source = snapshots / stage.name / 'style-base.css' if not unchanged and undo is None else base
        publications[swaync_provenance] = (
            f'{base_source}\n{hashlib.sha256(base.read_bytes()).hexdigest()}\n').encode()
        publications.update(metadata or {})
        # Refreshing inputs of the same source creates a new generation, not a
        # new user selection. Keep Undo pointing at the prior selected source.
        if ((mode in ('set', 'commit') and history_generation is not None) or
                (not unchanged and (mode == 'undo' or mode == 'set' and provenance != str(selected)))):
            recent = history[1].read_text().splitlines() if history[1].exists() else []
            selected_id = next((key for key, path in theme_sources(config).items()
                                if ':' in key and path.resolve() == selected), selected.name)
            publications[history[1]] = ('\n'.join(list(dict.fromkeys([selected_id, *filter(None, recent)]))[:10]) + '\n').encode()
            if old_generation is not None:
                publications[history[0]] = (old_generation.name + '\n').encode()
                publications[history[2]] = str(old_generation).encode()
        # Prepare all destination-local regular files before changing selection.
        # Ordinary publication errors restore prior bytes/links; not crash atomic.
        link = stage / 'selection'
        with ExitStack() as cleanup:
            pending = {}
            previous_identities = {}
            default_pending = {}
            for path, content in defaults.items():
                temporary = cleanup.enter_context(tempfile.TemporaryDirectory(prefix='.defaults-', dir=path.parent))
                new = Path(temporary) / 'new'
                new.write_bytes(content)
                default_pending[path] = new
            for path, content in publications.items():
                if initial_bootstrap and (path.exists() or path.is_symlink()):
                    raise ValueError(f'Theme output appeared during initial preparation: {path}')
                if not initial_bootstrap and path.exists() and not path.is_symlink() and path.read_bytes() == content:
                    continue
                temporary = Path(tempfile.mkdtemp(prefix='.theme-recovery-', dir=path.parent))
                recovery_dirs.append(temporary)
                new = temporary / 'new'
                new.write_bytes(content)
                backup = temporary / 'old'
                if not initial_bootstrap:
                    try:
                        previous = path.lstat()
                    except FileNotFoundError:
                        previous = None
                    if previous is not None:
                        if stat.S_ISLNK(previous.st_mode):
                            backup.symlink_to(path.readlink())
                        elif stat.S_ISREG(previous.st_mode):
                            shutil.copy2(path, backup)
                        else:
                            raise ValueError(f'Conflicting runtime path: {path}')
                        after = path.lstat()
                        if (not os.path.samestat(previous, after) or previous.st_mode != after.st_mode
                                or previous.st_uid != after.st_uid or previous.st_gid != after.st_gid
                                or previous.st_size != after.st_size or previous.st_mtime_ns != after.st_mtime_ns):
                            raise ValueError(f'Theme output changed during backup: {path}')
                        previous_identities[path] = {'device': previous.st_dev, 'inode': previous.st_ino,
                                                     'mode': stat.S_IMODE(previous.st_mode),
                                                     'uid': previous.st_uid, 'gid': previous.st_gid,
                                                     'mtime_ns': previous.st_mtime_ns, 'size': previous.st_size}
                pending[path] = (new, backup)
            recovery_root = Path(tempfile.mkdtemp(prefix='.recovery-', dir=snapshots))
            records = []
            for path, (_, backup) in pending.items():
                kind = 'symlink' if backup.is_symlink() else 'file' if backup.exists() else 'absent'
                info = backup.lstat() if kind != 'absent' else None
                records.append({'destination': str(path), 'prior': kind,
                                'staging': str(backup.parent),
                                'previous_identity': previous_identities.get(path),
                                'backup': str(backup) if info is not None else None,
                                'backup_identity': ({'device': info.st_dev, 'inode': info.st_ino,
                                                     'mode': stat.S_IMODE(info.st_mode),
                                                     'uid': info.st_uid, 'gid': info.st_gid,
                                                     'mtime_ns': info.st_mtime_ns, 'size': info.st_size}
                                                    if info is not None else None),
                                'link_text': os.readlink(backup) if kind == 'symlink' else None})
            manifest = {'version': 1, 'status': 'prepared', 'selection': str(current), 'previous_selection': old,
                        'previous_selection_identity': ({'device': selection.st_dev, 'inode': selection.st_ino,
                                                         'mode': stat.S_IMODE(selection.st_mode),
                                                         'uid': selection.st_uid, 'gid': selection.st_gid,
                                                         'mtime_ns': selection.st_mtime_ns}
                                                        if selection is not None else None),
                        'outputs': records, 'initialized_defaults': [str(path) for path in default_pending]}
            manifest_path = recovery_root / 'manifest.json'
            manifest_path.write_text(json.dumps(manifest, ensure_ascii=True, indent=2) + '\n')
            manifest_path.chmod(0o600)
            if not unchanged and undo is None:
                snapshot = snapshots / stage.name
                snapshot.mkdir()
                tree.rename(snapshot / selected.name)
                (stage / 'source').rename(snapshot / 'source')
                (stage / 'identity').rename(snapshot / 'identity')
                (stage / 'input').rename(snapshot / 'input')
                (stage / 'style-base.css').rename(snapshot / 'style-base.css')
                (stage / walker_base.name).rename(snapshot / walker_base.name)
                ready = snapshot / selected.name
            published = []
            initialized = []
            selection_published = False
            selection_published_stat = None
            retain_recovery = True
            try:
                # Exclusive links never overwrite personal preferences, including
                # a file created by another writer after validation. An ordinary
                # failure rolls back defaults created by this invocation as well.
                for path, new in default_pending.items():
                    new_stat = new.lstat()
                    os.link(new, path)
                    initialized.append((path, new_stat, defaults[path]))
                if not unchanged:
                    link.symlink_to(ready)
                    selection_published_stat = link.lstat()
                    if selection is None:
                        os.link(link, current, follow_symlinks=False)
                    else:
                        os.replace(link, current)
                    selection_published = True
                for path, (new, backup) in pending.items():
                    new_stat = new.lstat()
                    if initial_bootstrap:
                        os.link(new, path)
                    else:
                        os.replace(new, path)
                    published.append((path, new_stat, publications[path]))
            except BaseException as error:
                conflicts = []
                def still_ours(path, expected, content=None):
                    def matches(info):
                        return (os.path.samestat(info, expected) and info.st_uid == expected.st_uid
                                and info.st_gid == expected.st_gid
                                and stat.S_IMODE(info.st_mode) == stat.S_IMODE(expected.st_mode)
                                and info.st_mtime_ns == expected.st_mtime_ns)
                    try:
                        if not matches(path.lstat()):
                            return False
                        if content is None:
                            return True
                        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
                        with os.fdopen(fd, 'rb') as stream:
                            info = os.fstat(stream.fileno())
                            return (stat.S_ISREG(info.st_mode) and matches(info)
                                    and stream.read() == content)
                    except FileNotFoundError:
                        return False
                for path, expected, content in reversed(initialized):
                    try:
                        if still_ours(path, expected, content):
                            path.unlink()
                        else:
                            conflicts.append(path)
                    except OSError:
                        conflicts.append(path)
                for path, expected, content in reversed(published):
                    try:
                        if not still_ours(path, expected, content):
                            conflicts.append(path)
                            continue
                        backup = pending[path][1]
                        if backup.exists() or backup.is_symlink():
                            os.replace(backup, path)
                        else:
                            path.unlink()
                    except OSError:
                        conflicts.append(path)
                if selection_published:
                    try:
                        if not still_ours(current, selection_published_stat):
                            conflicts.append(current)
                        elif old is None:
                            current.unlink()
                        else:
                            if link.is_symlink():
                                link.unlink()
                            link.symlink_to(old)
                            os.replace(link, current)
                    except OSError:
                        conflicts.append(current)
                if conflicts:
                    try:
                        mark_recovery('rollback-incomplete')
                    except OSError as marker_error:
                        raise RuntimeError(f'{error}; rollback left changed paths: {", ".join(map(str, conflicts))}; '
                                           f'rollback marker failed: {marker_error}; recovery manifest: {manifest_path}') from error
                    raise RuntimeError(f'{error}; rollback left changed paths: {", ".join(map(str, conflicts))}; '
                                       f'recovery manifest: {manifest_path}') from error
                try:
                    mark_recovery('rolled-back')
                except OSError as marker_error:
                    raise RuntimeError(f'{error}; rollback completed but its marker failed: {marker_error}; '
                                       f'preserve remaining backups and inspect {manifest_path}') from error
                retain_recovery = False
                raise
            published_success = True
            try:
                mark_recovery('committed')
            except OSError as marker_error:
                raise RuntimeError(f'Publication completed but committed marker failed: {marker_error}; '
                                   f'preserve all backups and inspect {manifest_path}') from marker_error
            retain_recovery = False

    return ready


def main():
    args = sys.argv[1:]
    mode, slug = 'bootstrap', None
    live_args = None
    if args[:1] == ['live']:
        live_args = args[1:]
    elif args:
        mode = args.pop(0)
        if mode == 'set' and args[:1] == ['--no-gui']:
            args.pop(0)
        if mode == 'set' and len(args) == 1 and re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_-]*', args[0]):
            slug = args[0]
        elif mode != 'undo' or args:
            raise ValueError('Usage: theme-bootstrap | theme-set [--no-gui] SLUG | theme-undo')
    config = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config')))
    if not config.is_absolute() or '..' in config.parts:
        raise ValueError('XDG_CONFIG_HOME must be absolute without parent traversal')
    # Created runtime files must remain owner-readable under masks such as
    # 0400; never grant group/other writes, and retain their read restrictions.
    old_umask = os.umask(0o077)
    try:
        os.umask((old_umask & ~0o700) | 0o022)
        directory(config / 'current')
        # A persistent user-owned inode serializes source/provenance reads through
        # publication and rollback. Closing on every exit releases the flock.
        fd = os.open(config / 'current/.theme-bootstrap.lock',
                     os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        with os.fdopen(fd, 'a') as lock:
            info = os.fstat(lock.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_nlink != 1:
                raise ValueError('Bootstrap lock must be a user-owned regular file without hard links')
            fcntl.flock(lock, fcntl.LOCK_EX)
            if live_args is None:
                prepare(config, mode, slug)
            else:
                # One installed live API, same lock/publication/recovery owner.
                library = Path(__file__).resolve().parent.parent / 'libexec/dragon/theme-manager/lib/live.py'
                live = runpy.run_path(str(library))
                live['command'](sys.modules[__name__], config, live_args)
    finally:
        os.umask(old_umask)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, RuntimeError, configparser.Error, subprocess.SubprocessError) as error:
        print(f'theme-bootstrap: {error}', file=sys.stderr)
        sys.exit(1)
