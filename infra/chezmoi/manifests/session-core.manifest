required|packages/hyprland/.config/systemd/user/dragon-wallpaper.service|dot_config/systemd/user/dragon-wallpaper.service
required|scripts/theme-manager/theme-apply|dot_local/bin/theme-apply
required|scripts/theme-manager/theme-preview|dot_local/bin/theme-preview
