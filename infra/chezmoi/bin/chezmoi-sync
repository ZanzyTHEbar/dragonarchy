#!/usr/bin/env bash
#
# chezmoi-sync — Permanent manifest-to-chezmoi sync
#
# Usage: chezmoi-sync --host <hostname>
#
# Reads all manifests from infra/chezmoi/manifests/ and syncs the declared
# source paths into ~/.local/share/chezmoi/ (chezmoi's source directory).
#
# This is the permanent replacement for the temporary migration scripts
# (build-source.sh, verify-generated-source.sh, etc.).
#
# Design principles:
#   - Idempotent: running twice produces the same result
#   - Transactional: stages before promotion and retains bounded ownership state
#   - Manifest-driven: source of truth is the manifest files
#   - Direct: syncs to chezmoi's native source path

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CHEZMOI_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
REPO_ROOT="$(cd "${CHEZMOI_ROOT}/../.." && pwd)"

HOST_NAME=""
CHEZMOI_SOURCE_DIR="${HOME}/.local/share/chezmoi"
CHEZMOI_STATE_FILE=""
CHEZMOI_STAGE_DIR=""
CHEZMOI_BACKUP_DIR=""
CHEZMOI_LOCK_FILE=""
LIFECYCLE_LOCK_FD=""
MUTATION_ROOT=""
STAGED_SOURCE_ROOT_MODE=""

usage() {
    echo "Usage: $0 --host <hostname> [--source-dir <path>]" >&2
    echo "" >&2
    echo "Syncs manifest-declared dotfiles into chezmoi source directory." >&2
    echo "Default source dir: ${CHEZMOI_SOURCE_DIR}" >&2
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --host)
            HOST_NAME="${2:-}"
            shift 2
            ;;
        --source-dir)
            CHEZMOI_SOURCE_DIR="${2:-}"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            usage
            exit 2
            ;;
    esac
done

if [[ -z "${HOST_NAME}" ]]; then
    echo "Error: --host is required" >&2
    usage
    exit 2
fi

CHEZMOI_STATE_FILE="${CHEZMOI_SOURCE_DIR}.chezmoi-sync-state"
CHEZMOI_STAGE_DIR="${CHEZMOI_SOURCE_DIR}.chezmoi-sync-stage"
CHEZMOI_BACKUP_DIR="${CHEZMOI_SOURCE_DIR}.chezmoi-sync-backup"
CHEZMOI_LOCK_FILE="${CHEZMOI_SOURCE_DIR}.chezmoi-sync-lock"

# ---------------------------------------------------------------------------
# Discover manifests
# ---------------------------------------------------------------------------

MANIFEST_DIR="${CHEZMOI_ROOT}/manifests"
MANIFEST_PATHS=()

if [[ -d "${MANIFEST_DIR}" ]]; then
    while IFS= read -r -d '' manifest; do
        MANIFEST_PATHS+=("${manifest}")
    done < <(find "${MANIFEST_DIR}" -maxdepth 1 -name '*.manifest' -print0 | sort -z)
fi

if [[ ${#MANIFEST_PATHS[@]} -eq 0 ]]; then
    echo "Error: No manifests found in ${MANIFEST_DIR}" >&2
    exit 1
fi

echo "==> chezmoi-sync: host=${HOST_NAME} source=${CHEZMOI_SOURCE_DIR}"
echo "==> Manifests: ${#MANIFEST_PATHS[@]} found"

# ---------------------------------------------------------------------------
# Sync manifests to chezmoi source
# ---------------------------------------------------------------------------

declare -a RECORD_MODES=()
declare -a RECORD_SOURCES=()
declare -a RECORD_DESTINATIONS=()
declare -a RECORD_MANIFESTS=()
declare -a COPY_SOURCES=()
declare -a COPY_KINDS=()
declare -a COPY_DESTINATIONS=()
declare -a COPY_LOGICAL_DESTINATIONS=()
declare -a COPY_RECORD_INDEXES=()
declare -a EXCLUDE_DESTINATIONS=()
declare -A EXCLUDED_DESTINATIONS=()
declare -A OVERRIDE_LOGICAL_DESTINATIONS=()
declare -a DESIRED_STATE_PATHS=()
declare -A DESIRED_STATE_PATH_SET=()
declare -a STATE_OLD_PATHS=()
declare -a STATE_NEW_PATHS=()
declare -A STATE_OLD_PATH_SET=()
declare -A STATE_NEW_PATH_SET=()
STATE_STATUS="absent"

fail() {
    echo "Error: $*" >&2
    return 1
}

validate_relative_path() {
    local kind="$1"
    local path="$2"

    if [[ -z "${path}" || "${path}" == /* || "${path}" == */ || "${path}" == *//* || "${path}" =~ (^|/)\.\.?(/|$) ]]; then
        fail "Invalid manifest ${kind} path: ${path:-<empty>}"
        return
    fi
    return 0
}

validate_source_path() {
    local path="$1"

    validate_relative_path source "${path}"
    if [[ "${path}" != packages/* && "${path}" != "hosts/${HOST_NAME}/dotfiles/"* ]]; then
        fail "Manifest source is outside the allowed roots: ${path}"
        return
    fi
    return 0
}

validate_source_root() {
    local source_root="$1"
    local component current
    local -a components

    if [[ "${source_root}" != /* ]]; then
        fail "--source-dir must be absolute: ${source_root:-<empty>}"
        return
    fi
    if [[ "${source_root}" == / ]]; then
        fail "--source-dir cannot be the filesystem root"
        return
    fi
    if [[ "${source_root}" == */ || "${source_root}" == *//* || "${source_root}" =~ (^|/)\.\.?(/|$) ]]; then
        fail "--source-dir must be canonical: ${source_root}"
        return
    fi

    IFS='/' read -r -a components <<<"${source_root#/}"
    current=""
    for component in "${components[@]}"; do
        current="${current}/${component}"
        if [[ -L "${current}" ]]; then
            fail "--source-dir contains a symlink: ${current}"
            return
        fi
        if [[ -e "${current}" && ! -d "${current}" ]]; then
            fail "--source-dir is not a directory: ${current}"
            return
        fi
    done
    return 0
}

ensure_source_parent() {
    local source_parent

    validate_source_root "${CHEZMOI_SOURCE_DIR}"
    source_parent="$(dirname "${CHEZMOI_SOURCE_DIR}")"
    if ! mkdir -p -- "${source_parent}"; then
        fail "Cannot create --source-dir parent: ${source_parent}"
        return
    fi
    validate_source_root "${CHEZMOI_SOURCE_DIR}"
}

validate_source_ancestors() {
    local source_rel="$1"
    local component current="${REPO_ROOT}"
    local -a components
    local index

    IFS='/' read -r -a components <<<"${source_rel}"
    for ((index = 0; index < ${#components[@]} - 1; index++)); do
        current="${current}/${components[index]}"
        if [[ -L "${current}" ]]; then
            fail "Source path contains a symlink: ${current}"
            return
        fi
        if [[ -e "${current}" && ! -d "${current}" ]]; then
            fail "Source path ancestor is not a directory: ${current}"
            return
        fi
    done
    return 0
}

validate_destination_path_under_root() {
    local source_root="$1"
    local destination="$2"
    local relative component current
    local -a components
    local index

    if [[ -L "${source_root}" ]]; then
        fail "Destination path contains a symlink: ${source_root}"
        return
    fi
    if [[ -e "${source_root}" && ! -d "${source_root}" ]]; then
        fail "--source-dir is not a directory: ${source_root}"
        return
    fi
    relative="${destination#"${source_root}/"}"
    if [[ "${relative}" == "${destination}" || -z "${relative}" ]]; then
        fail "Destination escapes --source-dir: ${destination}"
        return
    fi

    IFS='/' read -r -a components <<<"${relative}"
    current="${source_root}"
    for ((index = 0; index < ${#components[@]}; index++)); do
        component="${components[index]}"
        current="${current}/${component}"
        if (( index < ${#components[@]} - 1 )) && [[ -L "${current}" ]]; then
            fail "Destination path contains a symlink: ${current}"
            return
        fi
        if (( index < ${#components[@]} - 1 )) && [[ -e "${current}" && ! -d "${current}" ]]; then
            fail "Destination path ancestor is not a directory: ${current}"
            return
        fi
    done
    return 0
}

validate_destination_path() {
    validate_destination_path_under_root "${CHEZMOI_SOURCE_DIR}" "$1"
}

validate_mutation_destination() {
    validate_destination_path_under_root "${MUTATION_ROOT}" "$1"
}

parse_manifest_record() {
    local manifest_path="$1"
    local line_number="$2"
    local record="$3"
    local mode remainder source_rel dest_rel

    if [[ "${record}" != *'|'* ]]; then
        fail "Malformed manifest record at ${manifest_path}:${line_number}"
        return
    fi
    mode="${record%%|*}"
    remainder="${record#*|}"
    if [[ "${remainder}" != *'|'* ]]; then
        fail "Malformed manifest record at ${manifest_path}:${line_number}"
        return
    fi
    source_rel="${remainder%%|*}"
    dest_rel="${remainder#*|}"
    if [[ "${dest_rel}" == *'|'* ]]; then
        fail "Malformed manifest record at ${manifest_path}:${line_number}"
        return
    fi

    source_rel="${source_rel//__HOST__/${HOST_NAME}}"
    dest_rel="${dest_rel//__HOST__/${HOST_NAME}}"
    case "${mode}" in
        required|optional)
            validate_source_path "${source_rel}"
            validate_relative_path destination "${dest_rel}"
            ;;
        exclude)
            if [[ -n "${source_rel}" ]]; then
                fail "Exclude source field must be empty at ${manifest_path}:${line_number}"
                return
            fi
            validate_relative_path destination "${dest_rel}"
            ;;
        *)
            fail "Unknown manifest mode at ${manifest_path}:${line_number}: ${mode:-<empty>}"
            return
            ;;
    esac

    RECORD_MODES+=("${mode}")
    RECORD_SOURCES+=("${source_rel}")
    RECORD_DESTINATIONS+=("${dest_rel}")
    RECORD_MANIFESTS+=("${manifest_path}")
    return 0
}

parse_manifests() {
    local manifest_path line line_number

    for manifest_path in "${MANIFEST_PATHS[@]}"; do
        line_number=0
        while IFS= read -r line || [[ -n "${line}" ]]; do
            ((line_number += 1))
            if [[ "${line}" == *$'\r'* ]]; then
                fail "Manifest record contains CR at ${manifest_path}:${line_number}"
                return
            fi
            [[ -z "${line}" || "${line}" == \#* ]] && continue
            parse_manifest_record "${manifest_path}" "${line_number}" "${line}"
        done < "${manifest_path}"
    done
    return 0
}

is_reserved_name() {
    case "$1" in
        dot_*|executable_*|private_*|symlink_*|literal_*|empty_*|readonly_*|create_*|modify_*|remove_*|exact_*|run_*|once_*|encrypted_*|after_*|before_*|external_*|onchange_*|*.tmpl)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

source_mode() {
    stat -c '%a' -- "$1"
}

encode_name() {
    local name="$1"
    local encoded_name="$name"
    local name_without_dot="$name"

    if [[ "${name}" == .* ]]; then
        name_without_dot="${name#.}"
        encoded_name="dot_"
        if is_reserved_name "${name_without_dot}"; then
            encoded_name+="literal_"
        fi
        encoded_name+="${name_without_dot}"
    elif is_reserved_name "${name}"; then
        encoded_name="literal_${name}"
    fi

    if [[ "${encoded_name}" == *.tmpl ]]; then
        encoded_name+='.tmpl'
    fi

    printf '%s' "${encoded_name}"
}

entry_kind() {
    local source_abs="$1"

    if [[ -L "${source_abs}" ]]; then
        printf '%s' symlink
    elif [[ -d "${source_abs}" ]]; then
        printf '%s' directory
    elif [[ -f "${source_abs}" ]]; then
        printf '%s' regular
    else
        echo "Error: Unsupported file type: ${source_abs}" >&2
        return 1
    fi
}

attribute_prefix() {
    local kind="$1"
    local source_abs="${2:-}"
    local prefix=""
    local mode_bits=0

    case "${kind}" in
        symlink)
            prefix='symlink_'
            ;;
        regular|directory)
            if [[ "${kind}" == regular ]]; then
                # Chezmoi needs empty_ to retain a tracked zero-byte file.
                mode_bits=$((8#$(source_mode "${source_abs}")))
                if (( (mode_bits & 0077) == 0 )); then
                    prefix+='private_'
                fi
                if (( (mode_bits & 0222) == 0 )); then
                    prefix+='readonly_'
                fi
                if [[ "$(stat -c '%s' -- "${source_abs}")" == 0 ]]; then
                    prefix+='empty_'
                fi
                if (( (mode_bits & 0111) != 0 )); then
                    prefix+='executable_'
                fi
            else
                mode_bits=$((8#$(source_mode "${source_abs}")))
                if (( (mode_bits & 0077) == 0 )); then
                    prefix+='private_'
                fi
                if (( (mode_bits & 0222) == 0 )); then
                    prefix+='readonly_'
                fi
            fi
            ;;
        *)
            echo "Error: Unsupported file type: ${source_abs}" >&2
            return 1
            ;;
    esac

    printf '%s' "${prefix}"
}

encoded_entry_name() {
    local source_abs="$1"
    local name="$2"
    local kind="$3"

    printf '%s%s' "$(attribute_prefix "${kind}" "${source_abs}")" "$(encode_name "${name}")"
}

encoded_direct_name() {
    local name="$1"

    if [[ "${name}" == dot_*.tmpl && "${name}" != dot_literal_*.tmpl ]]; then
        printf 'dot_literal_%s.tmpl' "${name#dot_}"
    elif [[ "${name}" == *.tmpl && "${name}" != literal_*.tmpl ]]; then
        printf 'literal_%s.tmpl' "${name}"
    else
        printf '%s' "${name}"
    fi
}

rendered_destination() {
    local source_abs="$1"
    local kind="$2"
    local logical_destination="$3"
    local destination_dir raw_name destination_name

    destination_dir="$(dirname "${logical_destination}")"
    raw_name="$(basename "${logical_destination}")"
    destination_name="$(encoded_direct_name "${raw_name}")"
    printf '%s/%s%s' "${destination_dir}" "$(attribute_prefix "${kind}" "${source_abs}")" "${destination_name}"
}

normalize_destination_component() {
    local component="$1"

    while :; do
        case "${component}" in
            private_*) component="${component#private_}" ;;
            readonly_*) component="${component#readonly_}" ;;
            empty_*) component="${component#empty_}" ;;
            executable_*) component="${component#executable_}" ;;
            symlink_*) component="${component#symlink_}" ;;
            *) break ;;
        esac
    done
    printf '%s' "${component}"
}

normalize_destination() {
    local destination="$1"
    local relative component normalized_relative=""
    local -a components

    [[ "${destination}" == "${CHEZMOI_SOURCE_DIR}" ]] && {
        printf '%s' "${destination}"
        return
    }
    relative="${destination#"${CHEZMOI_SOURCE_DIR}/"}"
    IFS='/' read -r -a components <<<"${relative}"
    for component in "${components[@]}"; do
        [[ -n "${normalized_relative}" ]] && normalized_relative+='/'
        normalized_relative+="$(normalize_destination_component "${component}")"
    done
    printf '%s/%s' "${CHEZMOI_SOURCE_DIR}" "${normalized_relative}"
}

destination_is_excluded() {
    local destination

    destination="$(normalize_destination "$1")"
    [[ -n "${EXCLUDED_DESTINATIONS[${destination}]+present}" ]]
}

destination_contains_exclusion() {
    local destination excluded normalized_excluded

    destination="$(normalize_destination "$1")"

    for excluded in "${EXCLUDE_DESTINATIONS[@]}"; do
        normalized_excluded="$(normalize_destination "${excluded}")"
        [[ "${normalized_excluded}" == "${destination}" || "${normalized_excluded}" == "${destination}/"* ]] && return 0
    done
    return 1
}

list_directory_children() {
    local directory="$1"
    local output_name="$2"
    local dotglob_set=0
    local nullglob_set=0
    local -n output="${output_name}"

    if [[ ! -r "${directory}" || ! -x "${directory}" ]]; then
        fail "Directory is not readable/searchable: ${directory}"
        return
    fi
    shopt -q dotglob && dotglob_set=1
    shopt -q nullglob && nullglob_set=1
    shopt -s dotglob nullglob
    output=("${directory}"/*)
    (( dotglob_set )) || shopt -u dotglob
    (( nullglob_set )) || shopt -u nullglob
    return 0
}

is_unsafe_distributable() {
    local source_abs="$1"
    local kind="$2"
    local name lower_name

    name="$(basename "${source_abs}")"
    lower_name="${name,,}"
    case "${lower_name}" in
        .env*|.git|.gitmodules|.gitattributes|.gitkeep|.package|readme*|.vscode|.idea|.vs|.fleet|.project|.classpath|.settings|*.code-workspace|*.sublime-project|*.sublime-workspace|secret|secret.*|secrets|secrets.*|credential|credential.*|credentials|credentials.*|password|password.*|passwd|passwd.*|token|token.*|api_key|api_key.*|api-key|api-key.*|apikey|apikey.*|access_token|access_token.*|access-token|access-token.*|auth_token|auth_token.*|auth-token|auth-token.*|client_secret|client_secret.*|client-secret|client-secret.*|private_key|private_key.*|private-key|private-key.*|id_rsa|id_rsa-*|id_rsa_*|id_dsa|id_dsa-*|id_dsa_*|id_ecdsa|id_ecdsa-*|id_ecdsa_*|id_ed25519|id_ed25519-*|id_ed25519_*|id_xmss|id_xmss-*|id_xmss_*|identity|*.pem|*.key|*.crt|*.cer|*.der|*.p12|*.pfx|*.jks|*.keystore|*~|*.bak|*.backup|*.old|*.orig|*.rej|*.swp|*.swo|*.log|*.log.*|clipboard_history.json)
            return 0
            ;;
    esac

    if [[ "${kind}" == directory ]]; then
        case "${lower_name}" in
            .cache|node_modules|bower_components|vendor|build|dist|out|target|coverage|backup|backups|.next|.nuxt|.svelte-kit|.angular|.turbo|.parcel-cache|.vite|.webpack|.rollup.cache|.yarn|.pnpm-store|.terraform|.gradle|.m2|.venv|venv|env|__pycache__|.pytest_cache|.mypy_cache|.ruff_cache|.tox|.nox)
                return 0
                ;;
        esac
    fi

    if [[ "${kind}" == regular ]] && LC_ALL=C grep -aqE -- '-----BEGIN ([A-Z0-9 ]+ )?PRIVATE KEY( BLOCK)?-----' "${source_abs}"; then
        return 0
    fi
    if [[ "${kind}" == regular ]] &&
        LC_ALL=C grep -aiE -- '^[[:space:]]*(export[[:space:]]+)?([[:alnum:]]+_)*(api[_-]?key|apikey|access[_-]?token|auth[_-]?token|bearer[_-]?token|client[_-]?secret|aws[_-]?access[_-]?key[_-]?id|aws[_-]?secret[_-]?access[_-]?key|database[_-]?url|db[_-]?password|password|passwd|secret|token|private[_-]?key|credentials?)[[:space:]]*[:=][[:space:]]*(['"'"'"][^$]|[[:alnum:]_+/-]+={0,2}([[:space:]]*(#.*)?$))' "${source_abs}" |
        LC_ALL=C grep -avE -- '^[^:=]*[:=][[:space:]]*\$\{\{' >/dev/null; then
        return 0
    fi
    if [[ "${kind}" == regular ]] &&
        LC_ALL=C grep -aiE -- '"(api[_-]?key|apikey|access[_-]?token|auth[_-]?token|bearer[_-]?token|client[_-]?secret|aws[_-]?access[_-]?key[_-]?id|aws[_-]?secret[_-]?access[_-]?key|database[_-]?url|db[_-]?password|password|passwd|secret|token|private[_-]?key|credentials?)"[[:space:]]*:[[:space:]]*"[^${"]+"' "${source_abs}" >/dev/null; then
        return 0
    fi
    return 1
}

validate_symlink_target() {
    local source_abs="$1"
    local destination="$2"
    local link_target resolved_target

    IFS= read -r -d '' link_target < <(readlink -z -- "${source_abs}")
    # -m -s normalizes path components without resolving filesystem symlinks.
    if [[ "${link_target}" == /* ]]; then
        resolved_target="$(realpath -ms -- "${link_target}")"
    else
        resolved_target="$(realpath -ms -- "$(dirname "${destination}")/${link_target}")"
    fi
    case "${resolved_target}" in
        "${CHEZMOI_SOURCE_DIR}"|"${CHEZMOI_SOURCE_DIR}"/*)
            return 0
            ;;
        *)
            fail "Symlink target escapes --source-dir: ${source_abs} -> ${link_target}"
            return
            ;;
    esac
}

preflight_tree_entry() {
    local source_abs="$1"
    local kind="$2"
    local destination="$3"
    local child child_name child_kind child_destination
    local -a children

    validate_destination_path "${destination}"
    destination_is_excluded "${destination}" && return 0
    if is_unsafe_distributable "${source_abs}" "${kind}"; then
        fail "Unsafe distributable artifact: ${source_abs}"
        return
    fi
    if [[ "${kind}" == symlink ]]; then
        validate_symlink_target "${source_abs}" "${destination}"
    fi
    [[ "${kind}" == directory ]] || return 0

    list_directory_children "${source_abs}" children
    for child in "${children[@]}"; do
        child_name="$(basename "${child}")"
        child_kind="$(entry_kind "${child}")"
        child_destination="${destination}/$(encoded_entry_name "${child}" "${child_name}" "${child_kind}")"
        preflight_tree_entry "${child}" "${child_kind}" "${child_destination}"
    done
    return 0
}

is_zsh_parent_record() {
    local index="$1"

    [[ "${RECORD_MANIFESTS[index]}" == "${MANIFEST_DIR}/session-zsh.manifest" &&
        "${RECORD_MODES[index]}" == required &&
        "${RECORD_SOURCES[index]}" == packages/zsh/.config/zsh &&
        "${RECORD_DESTINATIONS[index]}" == dot_config/zsh ]]
}

is_zsh_override_record() {
    local index="$1"
    local source_rel="${RECORD_SOURCES[index]}"
    local dest_rel="${RECORD_DESTINATIONS[index]}"

    [[ "${RECORD_MANIFESTS[index]}" == "${MANIFEST_DIR}/session-zsh.manifest" &&
        "${RECORD_MODES[index]}" == optional ]] || return 1
    case "${source_rel}|${dest_rel}" in
        "hosts/${HOST_NAME}/dotfiles/.config/zsh/hosts/${HOST_NAME}.env.zsh|dot_config/zsh/hosts/${HOST_NAME}.env.zsh"|\
        "hosts/${HOST_NAME}/dotfiles/.config/zsh/hosts/${HOST_NAME}.zsh|dot_config/zsh/hosts/${HOST_NAME}.zsh"|\
        "hosts/${HOST_NAME}/dotfiles/.config/zsh/functions/${HOST_NAME}.zsh|dot_config/zsh/functions/${HOST_NAME}.zsh")
            return 0
            ;;
    esac
    return 1
}

is_path_parent() {
    [[ "$2" == "$1/"* ]]
}

is_allowed_zsh_override_pair() {
    local first="$1"
    local second="$2"

    (is_zsh_parent_record "${first}" && is_zsh_override_record "${second}") ||
        (is_zsh_parent_record "${second}" && is_zsh_override_record "${first}")
}

validate_mapping_conflicts() {
    local first second first_dest second_dest

    for ((first = 0; first < ${#RECORD_MODES[@]}; first++)); do
        [[ "${RECORD_MODES[first]}" == exclude ]] && continue
        first_dest="${RECORD_DESTINATIONS[first]}"
        for ((second = 0; second < first; second++)); do
            [[ "${RECORD_MODES[second]}" == exclude ]] && continue
            second_dest="${RECORD_DESTINATIONS[second]}"
            if [[ "${first_dest}" == "${second_dest}" ]]; then
                fail "Duplicate logical destination: ${first_dest}"
                return
            fi
            if is_path_parent "${first_dest}" "${second_dest}" || is_path_parent "${second_dest}" "${first_dest}"; then
                if ! is_allowed_zsh_override_pair "${first}" "${second}"; then
                    fail "Mapped parent/child destination conflict: ${first_dest} and ${second_dest}"
                    return
                fi
            fi
        done
    done
    return 0
}

validate_rendered_mapping_conflicts() {
    local first second first_destination second_destination

    for ((first = 0; first < ${#COPY_DESTINATIONS[@]}; first++)); do
        first_destination="${COPY_DESTINATIONS[first]}"
        for ((second = 0; second < first; second++)); do
            second_destination="${COPY_DESTINATIONS[second]}"
            if [[ "${first_destination}" == "${second_destination}" ]]; then
                fail "Duplicate rendered destination: ${first_destination}"
                return
            fi
        done
    done
    return 0
}

preflight_records() {
    local index mode source_rel dest_rel source_abs logical_destination kind destination

    validate_source_root "${CHEZMOI_SOURCE_DIR}"
    for ((index = 0; index < ${#RECORD_MODES[@]}; index++)); do
        [[ "${RECORD_MODES[index]}" == exclude ]] || continue
        destination="${CHEZMOI_SOURCE_DIR}/${RECORD_DESTINATIONS[index]}"
        validate_destination_path "${destination}"
        EXCLUDE_DESTINATIONS+=("${destination}")
        EXCLUDED_DESTINATIONS["$(normalize_destination "${destination}")"]=1
    done

    for ((index = 0; index < ${#RECORD_MODES[@]}; index++)); do
        mode="${RECORD_MODES[index]}"
        [[ "${mode}" == exclude ]] && continue
        source_rel="${RECORD_SOURCES[index]}"
        dest_rel="${RECORD_DESTINATIONS[index]}"
        source_abs="${REPO_ROOT}/${source_rel}"
        logical_destination="${CHEZMOI_SOURCE_DIR}/${dest_rel}"

        validate_source_ancestors "${source_rel}"
        validate_destination_path "${logical_destination}"
        if [[ ! -e "${source_abs}" && ! -L "${source_abs}" ]]; then
            if [[ "${mode}" == required ]]; then
                fail "Required source missing: ${source_rel}"
                return
            fi
            continue
        fi

        kind="$(entry_kind "${source_abs}")"
        destination="$(rendered_destination "${source_abs}" "${kind}" "${logical_destination}")"
        validate_destination_path "${destination}"
        COPY_SOURCES+=("${source_abs}")
        COPY_KINDS+=("${kind}")
        COPY_DESTINATIONS+=("${destination}")
        COPY_LOGICAL_DESTINATIONS+=("${logical_destination}")
        COPY_RECORD_INDEXES+=("${index}")
    done

    validate_mapping_conflicts
    validate_rendered_mapping_conflicts
    for ((index = 0; index < ${#COPY_SOURCES[@]}; index++)); do
        if is_zsh_override_record "${COPY_RECORD_INDEXES[index]}"; then
            OVERRIDE_LOGICAL_DESTINATIONS["${COPY_LOGICAL_DESTINATIONS[index]}"]=1
        fi
        preflight_tree_entry "${COPY_SOURCES[index]}" "${COPY_KINDS[index]}" "${COPY_DESTINATIONS[index]}"
    done
    return 0
}

validate_state_path() {
    local path="$1"

    validate_relative_path state "${path}"
}

add_state_path() {
    local path="$1"
    local paths_name="$2"
    local seen_name="$3"
    local -n paths="${paths_name}"
    local -n seen="${seen_name}"

    validate_state_path "${path}"
    if [[ -n "${seen[${path}]+present}" ]]; then
        fail "Duplicate state path: ${path}"
        return
    fi
    paths+=("${path}")
    seen["${path}"]=1
}

read_state_file() {
    local state_fd header status record section="old" saw_separator=0

    STATE_STATUS="absent"
    STATE_OLD_PATHS=()
    STATE_NEW_PATHS=()
    STATE_OLD_PATH_SET=()
    STATE_NEW_PATH_SET=()
    [[ -e "${CHEZMOI_STATE_FILE}" ]] || return 0

    if [[ -L "${CHEZMOI_STATE_FILE}" || ! -f "${CHEZMOI_STATE_FILE}" || ! -r "${CHEZMOI_STATE_FILE}" ]]; then
        fail "Invalid transaction state file: ${CHEZMOI_STATE_FILE}"
        return
    fi
    if ! exec {state_fd}<"${CHEZMOI_STATE_FILE}"; then
        fail "Cannot read transaction state file: ${CHEZMOI_STATE_FILE}"
        return
    fi
    if ! IFS= read -r -d '' header <&"${state_fd}" || [[ "${header}" != chezmoi-sync-state-v1 ]]; then
        exec {state_fd}<&-
        fail "Invalid transaction state file: ${CHEZMOI_STATE_FILE}"
        return
    fi
    if ! IFS= read -r -d '' status <&"${state_fd}"; then
        exec {state_fd}<&-
        fail "Invalid transaction state file: ${CHEZMOI_STATE_FILE}"
        return
    fi
    case "${status}" in
        complete|prepared|prepared-new) STATE_STATUS="${status}" ;;
        *)
            exec {state_fd}<&-
            fail "Invalid transaction state file: ${CHEZMOI_STATE_FILE}"
            return
            ;;
    esac

    while :; do
        record=""
        if IFS= read -r -d '' record <&"${state_fd}"; then
            if [[ "${STATE_STATUS}" == complete ]]; then
                [[ -n "${record}" ]] || {
                    exec {state_fd}<&-
                    fail "Invalid transaction state file: ${CHEZMOI_STATE_FILE}"
                    return
                }
                add_state_path "${record}" STATE_OLD_PATHS STATE_OLD_PATH_SET
            elif [[ -z "${record}" ]]; then
                if (( saw_separator )); then
                    exec {state_fd}<&-
                    fail "Invalid transaction state file: ${CHEZMOI_STATE_FILE}"
                    return
                fi
                section="new"
                saw_separator=1
            elif [[ "${section}" == old ]]; then
                add_state_path "${record}" STATE_OLD_PATHS STATE_OLD_PATH_SET
            else
                add_state_path "${record}" STATE_NEW_PATHS STATE_NEW_PATH_SET
            fi
        else
            [[ -z "${record}" ]] || {
                exec {state_fd}<&-
                fail "Invalid transaction state file: ${CHEZMOI_STATE_FILE}"
                return
            }
            break
        fi
    done
    exec {state_fd}<&-

    if [[ "${STATE_STATUS}" == prepared || "${STATE_STATUS}" == prepared-new ]] && (( ! saw_separator )); then
        fail "Invalid transaction state file: ${CHEZMOI_STATE_FILE}"
        return
    fi
    if [[ "${STATE_STATUS}" == prepared-new && ${#STATE_OLD_PATHS[@]} -ne 0 ]]; then
        fail "Invalid transaction state file: ${CHEZMOI_STATE_FILE}"
        return
    fi
    return 0
}

write_complete_state() {
    local state_temp path
    local -a paths=("$@")

    state_temp="$(mktemp -- "${CHEZMOI_STATE_FILE}.tmp.XXXXXX")"
    if ! {
        printf '%s\0%s\0' chezmoi-sync-state-v1 complete
        for path in "${paths[@]}"; do
            printf '%s\0' "${path}"
        done
    } >"${state_temp}"; then
        rm -f -- "${state_temp}"
        return 1
    fi
    chmod 0600 -- "${state_temp}"
    mv -f -- "${state_temp}" "${CHEZMOI_STATE_FILE}"
}

write_prepared_state() {
    local status="$1"
    local old_paths_name="$2"
    local new_paths_name="$3"
    local state_temp path
    local -n old_paths="${old_paths_name}"
    local -n new_paths="${new_paths_name}"

    state_temp="$(mktemp -- "${CHEZMOI_STATE_FILE}.tmp.XXXXXX")"
    if ! {
        printf '%s\0%s\0' chezmoi-sync-state-v1 "${status}"
        for path in "${old_paths[@]}"; do
            printf '%s\0' "${path}"
        done
        printf '\0'
        for path in "${new_paths[@]}"; do
            printf '%s\0' "${path}"
        done
    } >"${state_temp}"; then
        rm -f -- "${state_temp}"
        return 1
    fi
    chmod 0600 -- "${state_temp}"
    mv -f -- "${state_temp}" "${CHEZMOI_STATE_FILE}"
}

validate_lifecycle_paths() {
    local path kind

    for kind in state stage backup lock; do
        case "${kind}" in
            state) path="${CHEZMOI_STATE_FILE}" ;;
            stage) path="${CHEZMOI_STAGE_DIR}" ;;
            backup) path="${CHEZMOI_BACKUP_DIR}" ;;
            lock) path="${CHEZMOI_LOCK_FILE}" ;;
        esac
        if [[ -L "${path}" ]]; then
            fail "Transaction ${kind} path is a symlink: ${path}"
            return
        fi
        if [[ -e "${path}" ]]; then
            if [[ "${kind}" == state || "${kind}" == lock ]]; then
                [[ -f "${path}" ]] || {
                    fail "Invalid transaction ${kind} path: ${path}"
                    return
                }
            elif [[ ! -d "${path}" ]]; then
                fail "Invalid transaction ${kind} path: ${path}"
                return
            fi
        fi
    done
    return 0
}

ensure_lifecycle_lock_file() {
    local lock_temp

    if [[ -L "${CHEZMOI_LOCK_FILE}" ]]; then
        fail "Transaction lock path is a symlink: ${CHEZMOI_LOCK_FILE}"
        return
    fi
    if [[ ! -e "${CHEZMOI_LOCK_FILE}" ]]; then
        lock_temp="$(mktemp -- "${CHEZMOI_LOCK_FILE}.tmp.XXXXXX")"
        chmod 0600 -- "${lock_temp}"
        if ! ln -T -- "${lock_temp}" "${CHEZMOI_LOCK_FILE}"; then
            rm -f -- "${lock_temp}"
            if [[ -L "${CHEZMOI_LOCK_FILE}" || ! -f "${CHEZMOI_LOCK_FILE}" ]]; then
                fail "Invalid transaction lock path: ${CHEZMOI_LOCK_FILE}"
                return
            fi
        else
            rm -f -- "${lock_temp}"
        fi
    fi
    if [[ -L "${CHEZMOI_LOCK_FILE}" || ! -f "${CHEZMOI_LOCK_FILE}" ]]; then
        fail "Invalid transaction lock path: ${CHEZMOI_LOCK_FILE}"
        return
    fi
}

acquire_lifecycle_lock() {
    local lock_fd

    ensure_lifecycle_lock_file
    if ! exec {lock_fd}<>"${CHEZMOI_LOCK_FILE}"; then
        fail "Cannot open transaction lock: ${CHEZMOI_LOCK_FILE}"
        return
    fi
    if [[ -L "${CHEZMOI_LOCK_FILE}" || ! -f "${CHEZMOI_LOCK_FILE}" ]]; then
        exec {lock_fd}>&-
        fail "Invalid transaction lock path: ${CHEZMOI_LOCK_FILE}"
        return
    fi
    if ! flock -x "${lock_fd}"; then
        exec {lock_fd}>&-
        fail "Cannot acquire transaction lock: ${CHEZMOI_LOCK_FILE}"
        return
    fi
    LIFECYCLE_LOCK_FD="${lock_fd}"
}

make_lifecycle_tree_removable() {
    local directory="$1"
    local child
    local -a children

    [[ -d "${directory}" && ! -L "${directory}" ]] || {
        fail "Invalid transaction cleanup path: ${directory}"
        return
    }
    if [[ ! -r "${directory}" || ! -w "${directory}" || ! -x "${directory}" ]]; then
        chmod u+rwx -- "${directory}"
    fi
    list_directory_children "${directory}" children
    for child in "${children[@]}"; do
        [[ -d "${child}" && ! -L "${child}" ]] || continue
        make_lifecycle_tree_removable "${child}"
    done
}

remove_lifecycle_tree() {
    local path="$1"

    case "${path}" in
        "${CHEZMOI_STAGE_DIR}"|"${CHEZMOI_BACKUP_DIR}") ;;
        *)
            fail "Invalid transaction cleanup path: ${path}"
            return
            ;;
    esac
    if [[ -L "${path}" || ! -d "${path}" ]]; then
        fail "Invalid transaction cleanup path: ${path}"
        return
    fi
    make_lifecycle_tree_removable "${path}"
    rm -rf -- "${path}"
}

complete_recovery_state() {
    if [[ "${STATE_STATUS}" == prepared-new ]]; then
        rm -f -- "${CHEZMOI_STATE_FILE}"
        STATE_STATUS="absent"
        STATE_OLD_PATHS=()
        STATE_OLD_PATH_SET=()
    else
        write_complete_state "${STATE_OLD_PATHS[@]}"
        STATE_STATUS="complete"
    fi
}

recover_lifecycle() {
    case "${STATE_STATUS}" in
        absent)
            if [[ -d "${CHEZMOI_STAGE_DIR}" && ! -e "${CHEZMOI_BACKUP_DIR}" ]]; then
                # A state-less stage can only be the abandoned copy transaction.
                remove_lifecycle_tree "${CHEZMOI_STAGE_DIR}"
            elif [[ -e "${CHEZMOI_STAGE_DIR}" || -e "${CHEZMOI_BACKUP_DIR}" ]]; then
                fail "Untracked transaction lifecycle paths exist"
                return
            fi
            return 0
            ;;
        complete)
            if [[ -d "${CHEZMOI_SOURCE_DIR}" && -d "${CHEZMOI_STAGE_DIR}" && ! -e "${CHEZMOI_BACKUP_DIR}" ]]; then
                # Stage is transaction-owned; active source is never removed recursively.
                remove_lifecycle_tree "${CHEZMOI_STAGE_DIR}"
            elif [[ -d "${CHEZMOI_SOURCE_DIR}" && ! -e "${CHEZMOI_STAGE_DIR}" && -d "${CHEZMOI_BACKUP_DIR}" ]]; then
                # The new root and complete state are durable; only old transaction data remains.
                remove_lifecycle_tree "${CHEZMOI_BACKUP_DIR}"
            elif [[ ! -d "${CHEZMOI_SOURCE_DIR}" || -e "${CHEZMOI_STAGE_DIR}" || -e "${CHEZMOI_BACKUP_DIR}" ]]; then
                fail "Unknown transaction recovery topology"
                return
            fi
            return 0
            ;;
        prepared|prepared-new)
            if [[ -d "${CHEZMOI_BACKUP_DIR}" && ! -e "${CHEZMOI_SOURCE_DIR}" && -d "${CHEZMOI_STAGE_DIR}" ]]; then
                remove_lifecycle_tree "${CHEZMOI_STAGE_DIR}"
                mv -- "${CHEZMOI_BACKUP_DIR}" "${CHEZMOI_SOURCE_DIR}"
            elif [[ -d "${CHEZMOI_BACKUP_DIR}" && -d "${CHEZMOI_SOURCE_DIR}" && ! -e "${CHEZMOI_STAGE_DIR}" ]]; then
                mv -- "${CHEZMOI_SOURCE_DIR}" "${CHEZMOI_STAGE_DIR}"
                mv -- "${CHEZMOI_BACKUP_DIR}" "${CHEZMOI_SOURCE_DIR}"
                remove_lifecycle_tree "${CHEZMOI_STAGE_DIR}"
            elif [[ -d "${CHEZMOI_SOURCE_DIR}" && -d "${CHEZMOI_STAGE_DIR}" && ! -e "${CHEZMOI_BACKUP_DIR}" ]]; then
                # Prepared state is durable but active source was never parked.
                remove_lifecycle_tree "${CHEZMOI_STAGE_DIR}"
            elif [[ "${STATE_STATUS}" == prepared-new && ! -e "${CHEZMOI_BACKUP_DIR}" && ! -e "${CHEZMOI_SOURCE_DIR}" && -d "${CHEZMOI_STAGE_DIR}" ]]; then
                remove_lifecycle_tree "${CHEZMOI_STAGE_DIR}"
            elif [[ "${STATE_STATUS}" == prepared-new && ! -e "${CHEZMOI_BACKUP_DIR}" && -d "${CHEZMOI_SOURCE_DIR}" && ! -e "${CHEZMOI_STAGE_DIR}" ]]; then
                mv -- "${CHEZMOI_SOURCE_DIR}" "${CHEZMOI_STAGE_DIR}"
                remove_lifecycle_tree "${CHEZMOI_STAGE_DIR}"
            else
                fail "Unknown transaction recovery topology"
                return
            fi
            complete_recovery_state
            return 0
            ;;
    esac
}

add_desired_destination() {
    local destination="$1"
    local relative

    validate_destination_path "${destination}"
    relative="${destination#"${CHEZMOI_SOURCE_DIR}/"}"
    if [[ "${relative}" == "${destination}" ]]; then
        fail "Destination escapes --source-dir: ${destination}"
        return
    fi
    if [[ -n "${DESIRED_STATE_PATH_SET[${relative}]+present}" ]]; then
        fail "Duplicate rendered destination: ${relative}"
        return
    fi
    DESIRED_STATE_PATHS+=("${relative}")
    DESIRED_STATE_PATH_SET["${relative}"]=1
}

collect_tree_destinations() {
    local source_abs="$1"
    local destination="$2"
    local logical_destination="$3"
    local child child_name child_kind child_destination child_logical_destination
    local -a children

    destination_is_excluded "${destination}" && return 0
    add_desired_destination "${destination}"
    list_directory_children "${source_abs}" children
    for child in "${children[@]}"; do
        child_name="$(basename "${child}")"
        child_kind="$(entry_kind "${child}")"
        child_destination="${destination}/$(encoded_entry_name "${child}" "${child_name}" "${child_kind}")"
        child_logical_destination="${logical_destination}/${child_name}"
        if destination_is_excluded "${child_destination}" || [[ -n "${OVERRIDE_LOGICAL_DESTINATIONS[${child_logical_destination}]+present}" ]]; then
            continue
        fi
        if [[ "${child_kind}" == directory ]]; then
            collect_tree_destinations "${child}" "${child_destination}" "${child_logical_destination}"
        else
            add_desired_destination "${child_destination}"
        fi
    done
}

collect_desired_destinations() {
    local index

    DESIRED_STATE_PATHS=()
    DESIRED_STATE_PATH_SET=()
    for ((index = 0; index < ${#COPY_SOURCES[@]}; index++)); do
        destination_is_excluded "${COPY_DESTINATIONS[index]}" && continue
        if [[ "${COPY_KINDS[index]}" == directory ]]; then
            collect_tree_destinations \
                "${COPY_SOURCES[index]}" \
                "${COPY_DESTINATIONS[index]}" \
                "${COPY_LOGICAL_DESTINATIONS[index]}"
        else
            add_desired_destination "${COPY_DESTINATIONS[index]}"
        fi
    done
}

stage_destination() {
    local destination="$1"
    local relative="${destination#"${CHEZMOI_SOURCE_DIR}/"}"

    [[ "${relative}" != "${destination}" ]] || {
        fail "Destination escapes --source-dir: ${destination}"
        return
    }
    printf '%s/%s' "${CHEZMOI_STAGE_DIR}" "${relative}"
}

prepare_destination_parent() {
    local destination="$1"
    local parent

    validate_mutation_destination "${destination}"
    parent="$(dirname "${destination}")"
    if [[ -e "${parent}" ]]; then
        chmod u+rwx -- "${parent}"
    else
        mkdir -p -- "${parent}"
    fi
}

remove_destination() {
    local destination="$1"

    validate_mutation_destination "${destination}"
    [[ -e "${destination}" || -L "${destination}" ]] || return 0
    prepare_destination_parent "${destination}"
    if [[ -d "${destination}" && ! -L "${destination}" ]]; then
        rmdir -- "${destination}"
    else
        rm -f -- "${destination}"
    fi
}

remove_contained_destination() {
    local destination="$1"

    validate_mutation_destination "${destination}"
    [[ -e "${destination}" || -L "${destination}" ]] || return 0
    if [[ -d "${destination}" && ! -L "${destination}" ]]; then
        make_lifecycle_tree_removable "${destination}"
        rm -rf -- "${destination}"
    else
        remove_destination "${destination}"
    fi
}

remove_stale_destination() {
    local destination="$1"

    validate_mutation_destination "${destination}"
    [[ -e "${destination}" || -L "${destination}" ]] || return 0
    if [[ -d "${destination}" && ! -L "${destination}" ]]; then
        prepare_destination_parent "${destination}"
        rmdir -- "${destination}" 2>/dev/null || true
    else
        remove_destination "${destination}"
    fi
}

ensure_directory() {
    local destination="$1"

    validate_mutation_destination "${destination}"
    if [[ -d "${destination}" && ! -L "${destination}" ]]; then
        chmod u+rwx -- "${destination}"
    elif [[ -e "${destination}" || -L "${destination}" ]]; then
        remove_destination "${destination}"
        mkdir -p -- "${destination}"
    else
        prepare_destination_parent "${destination}"
        mkdir -p -- "${destination}"
    fi
}

copy_symlink() {
    local source_abs="$1"
    local destination="$2"
    local link_target

    prepare_destination_parent "${destination}"
    remove_destination "${destination}"
    IFS= read -r -d '' link_target < <(readlink -z -- "${source_abs}")
    printf '%s' "${link_target}" >"${destination}"
    chmod 0644 -- "${destination}"
}

copy_regular_file() {
    local source_abs="$1"
    local destination="$2"

    prepare_destination_parent "${destination}"
    remove_destination "${destination}"
    cp --preserve=mode,timestamps -- "${source_abs}" "${destination}"
}

copy_tree() {
    local source_abs="$1"
    local destination="$2"
    local active_destination="$3"
    local logical_destination="$4"
    local child child_name child_kind child_destination child_active_destination child_logical_destination
    local -a children

    destination_is_excluded "${active_destination}" && return 0
    ensure_directory "${destination}"
    list_directory_children "${source_abs}" children
    for child in "${children[@]}"; do
        child_name="$(basename "${child}")"
        child_kind="$(entry_kind "${child}")"
        child_destination="${destination}/$(encoded_entry_name "${child}" "${child_name}" "${child_kind}")"
        child_active_destination="${active_destination}/$(encoded_entry_name "${child}" "${child_name}" "${child_kind}")"
        child_logical_destination="${logical_destination}/${child_name}"
        if destination_is_excluded "${child_active_destination}" || [[ -n "${OVERRIDE_LOGICAL_DESTINATIONS[${child_logical_destination}]+present}" ]]; then
            continue
        fi
        case "${child_kind}" in
            directory)
                copy_tree "${child}" "${child_destination}" "${child_active_destination}" "${child_logical_destination}"
                chmod "$(source_mode "${child}")" -- "${child_destination}"
                ;;
            regular)
                copy_regular_file "${child}" "${child_destination}"
                ;;
            symlink)
                copy_symlink "${child}" "${child_destination}"
                ;;
        esac
    done
    chmod "$(source_mode "${source_abs}")" -- "${destination}"
}

remove_legacy_direct_alternates() {
    local active_destination="$1"
    local logical_destination="$2"
    local active_directory staged_directory raw_name destination_name prefix active_candidate staged_candidate
    local -a prefixes=(
        ''
        private_ readonly_ empty_ executable_ symlink_
        private_readonly_ private_empty_ private_executable_
        readonly_empty_ readonly_executable_ empty_executable_
        private_readonly_empty_ private_readonly_executable_
        private_empty_executable_ readonly_empty_executable_
        private_readonly_empty_executable_
        empty_private_ executable_empty_ readonly_private_
    )

    [[ "${STATE_STATUS}" == absent ]] || return 0
    active_directory="$(dirname "${active_destination}")"
    staged_directory="$(dirname "$(stage_destination "${active_destination}")")"
    raw_name="$(basename "${logical_destination}")"
    destination_name="$(encoded_direct_name "${raw_name}")"
    for prefix in "${prefixes[@]}"; do
        active_candidate="${active_directory}/${prefix}${destination_name}"
        staged_candidate="${staged_directory}/${prefix}${destination_name}"
        destination_contains_exclusion "${active_candidate}" || remove_contained_destination "${staged_candidate}"
    done
    if [[ "${destination_name}" != "${raw_name}" ]]; then
        for prefix in "${prefixes[@]}"; do
            active_candidate="${active_directory}/${prefix}${raw_name}"
            staged_candidate="${staged_directory}/${prefix}${raw_name}"
            destination_contains_exclusion "${active_candidate}" || remove_contained_destination "${staged_candidate}"
        done
    fi
}

copy_entry() {
    local index="$1"
    local source_abs="${COPY_SOURCES[index]}"
    local kind="${COPY_KINDS[index]}"
    local active_destination="${COPY_DESTINATIONS[index]}"
    local destination

    destination_is_excluded "${active_destination}" && return 0
    destination="$(stage_destination "${active_destination}")"
    remove_legacy_direct_alternates "${active_destination}" "${COPY_LOGICAL_DESTINATIONS[index]}"
    case "${kind}" in
        directory)
            copy_tree "${source_abs}" "${destination}" "${active_destination}" "${COPY_LOGICAL_DESTINATIONS[index]}"
            ;;
        regular)
            copy_regular_file "${source_abs}" "${destination}"
            ;;
        symlink)
            copy_symlink "${source_abs}" "${destination}"
            ;;
    esac
}

remove_excluded_destination_candidates() {
    local directory="$1"
    local active_directory="$2"
    local directory_mode candidate active_candidate
    local -a children

    directory_mode="$(source_mode "${directory}")"
    chmod u+rwx -- "${directory}"
    list_directory_children "${directory}" children
    for candidate in "${children[@]}"; do
        active_candidate="${active_directory}/${candidate#"${directory}/"}"
        if destination_is_excluded "${active_candidate}"; then
            remove_contained_destination "${candidate}"
        elif [[ -d "${candidate}" && ! -L "${candidate}" ]]; then
            remove_excluded_destination_candidates "${candidate}" "${active_candidate}"
        fi
    done
    chmod "${directory_mode}" -- "${directory}"
}

inject_failure() {
    [[ "${CHEZMOI_SYNC_FAILPOINT:-}" == "$1" ]] || return 0
    echo "Injected chezmoi-sync failure: $1" >&2
    return 1
}

prepare_stage() {
    [[ ! -e "${CHEZMOI_STAGE_DIR}" ]] || remove_lifecycle_tree "${CHEZMOI_STAGE_DIR}"
    mkdir -- "${CHEZMOI_STAGE_DIR}"
    STAGED_SOURCE_ROOT_MODE=""
    if [[ -d "${CHEZMOI_SOURCE_DIR}" ]]; then
        STAGED_SOURCE_ROOT_MODE="$(source_mode "${CHEZMOI_SOURCE_DIR}")"
        cp -R --preserve=mode,timestamps --no-dereference -- \
            "${CHEZMOI_SOURCE_DIR}/." "${CHEZMOI_STAGE_DIR}/"
    fi
    MUTATION_ROOT="${CHEZMOI_STAGE_DIR}"
}

cleanup_stale_destinations() {
    local index relative destination stale_count=0

    for ((index = ${#STATE_OLD_PATHS[@]} - 1; index >= 0; index--)); do
        relative="${STATE_OLD_PATHS[index]}"
        [[ -n "${DESIRED_STATE_PATH_SET[${relative}]+present}" ]] && continue
        destination="${CHEZMOI_STAGE_DIR}/${relative}"
        remove_stale_destination "${destination}"
        ((stale_count += 1))
        if (( stale_count == 1 )); then
            inject_failure stale-cleanup:1
        fi
    done
}

promote_stage() {
    local prepared_status=prepared

    [[ "${STATE_STATUS}" == absent ]] && prepared_status=prepared-new
    write_prepared_state "${prepared_status}" STATE_OLD_PATHS DESIRED_STATE_PATHS
    inject_failure promote:after-prepare
    if [[ -d "${CHEZMOI_SOURCE_DIR}" ]]; then
        mv -- "${CHEZMOI_SOURCE_DIR}" "${CHEZMOI_BACKUP_DIR}"
        inject_failure promote:after-park
    fi
    mv -- "${CHEZMOI_STAGE_DIR}" "${CHEZMOI_SOURCE_DIR}"
    inject_failure promote:after-root
    write_complete_state "${DESIRED_STATE_PATHS[@]}"
    STATE_STATUS=complete
    inject_failure finalize:before-backup-delete
    [[ ! -e "${CHEZMOI_BACKUP_DIR}" ]] || remove_lifecycle_tree "${CHEZMOI_BACKUP_DIR}"
}

parse_manifests
preflight_records

# No filesystem mutation occurs before all manifest and tree preflight checks pass.
ensure_source_parent
acquire_lifecycle_lock
validate_lifecycle_paths
read_state_file
collect_desired_destinations
recover_lifecycle

for manifest_path in "${MANIFEST_PATHS[@]}"; do
    echo "    -> $(basename "${manifest_path}")"
done
prepare_stage
for ((index = 0; index < ${#COPY_SOURCES[@]}; index++)); do
    copy_entry "${index}"
    if (( index == 0 )); then
        inject_failure copy:1
    fi
done
cleanup_stale_destinations
remove_excluded_destination_candidates "${CHEZMOI_STAGE_DIR}" "${CHEZMOI_SOURCE_DIR}"
[[ -z "${STAGED_SOURCE_ROOT_MODE}" ]] || chmod "${STAGED_SOURCE_ROOT_MODE}" -- "${CHEZMOI_STAGE_DIR}"
promote_stage

echo "==> Sync complete. Run 'chezmoi apply' to update home directory."
